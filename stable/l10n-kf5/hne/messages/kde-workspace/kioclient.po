#: kioclient.cpp:75
msgid ""
"\n"
"Syntax:\n"
msgstr ""
"\n"
"सिंटेक्स:\n"

#: kioclient.cpp:76
msgid ""
"  kioclient openProperties 'url'\n"
"            # Opens a properties menu\n"
"\n"
msgstr ""
"  kioclient openProperties 'url'\n"
"            # प्रापर्टी मेन्यू खोलथे \n"
"\n"

#: kioclient.cpp:78
msgid ""
"  kioclient exec 'url' ['mimetype']\n"
"            # Tries to open the document pointed to by 'url', in the "
"application\n"
"            #   associated with it in KDE. You may omit 'mimetype'.\n"
"            #   In this case the mimetype is determined\n"
"            #   automatically. Of course URL may be the URL of a\n"
"            #   document, or it may be a *.desktop file.\n"
"            #   'url' can be an executable, too.\n"
msgstr ""

#: kioclient.cpp:85
msgid ""
"  kioclient move 'src' 'dest'\n"
"            # Moves the URL 'src' to 'dest'.\n"
"            #   'src' may be a list of URLs.\n"
msgstr ""
"  kioclient move 'src' 'dest'\n"
"            # खिसकाथे  'स्रोत' ल 'गंतव्य' में.\n"
"            #   'स्रोत' यूआरएल के सूची हो सकथे .\n"

#: kioclient.cpp:88
msgid ""
"            #   'dest' may be \"trash:/\" to move the files\n"
"            #   to the trash.\n"
msgstr ""

#: kioclient.cpp:90
msgid ""
"            #   the short version kioclient mv\n"
"            #   is also available.\n"
"\n"
msgstr ""

#: kioclient.cpp:92
msgid ""
"  kioclient download ['src']\n"
"            # Copies the URL 'src' to a user-specified location'.\n"
"            #   'src' may be a list of URLs, if not present then\n"
"            #   a URL will be requested.\n"
"\n"
msgstr ""
" kioclient download ['src']\n"
"            # यूआरएल 'स्रोत' ल कमइया के बताय निरधारित जगह मं नकल करथे '.\n"
"            #   'स्रोत' यूआरएल के सूची हो सकथे. अउ यदि मौजूद नइ हे तो\n"
"            #   यूआरएल बर निवेदन करे जाही.\n"
"\n"

#: kioclient.cpp:96
#, fuzzy
msgid ""
"  kioclient copy 'src' 'dest'\n"
"            # Copies the URL 'src' to 'dest'.\n"
"            #   'src' may be a list of URLs.\n"
msgstr ""
"  kioclient copy 'src' 'dest'\n"
"            # यूआरए 'स्रोत' ल 'गंतव्य' मं नकल करथे .\n"
"            #   'स्रोत' यूआरएल के सूची हो सकथे .\n"
"\n"

#: kioclient.cpp:99
msgid ""
"            #   the short version kioclient cp\n"
"            #   is also available.\n"
"\n"
msgstr ""

#: kioclient.cpp:101
msgid ""
"  kioclient cat 'url'\n"
"            # Writes out the contents of 'url' to stdout\n"
"\n"
msgstr ""
" kioclient cat 'url'\n"
"            # यूआरएल के सामान ल एसटीडीआउट मं लिखथे \n"
"\n"

#: kioclient.cpp:103
#, fuzzy
msgid ""
"  kioclient ls 'url'\n"
"            # Lists the contents of the directory 'url' to stdout\n"
"\n"
msgstr ""
" kioclient cat 'url'\n"
"            # यूआरएल के सामान ल एसटीडीआउट मं लिखथे \n"
"\n"

#: kioclient.cpp:105
#, fuzzy
msgid ""
"  kioclient remove 'url'\n"
"            # Removes the URL\n"
"            #   'url' may be a list of URLs.\n"
msgstr ""
"  kioclient move 'src' 'dest'\n"
"            # खिसकाथे  'स्रोत' ल 'गंतव्य' में.\n"
"            #   'स्रोत' यूआरएल के सूची हो सकथे .\n"

#: kioclient.cpp:108
msgid ""
"            #   the short version kioclient rm\n"
"            #   is also available.\n"
"\n"
msgstr ""

#: kioclient.cpp:111
msgid ""
"*** Examples:\n"
"  kioclient exec file:/root/Desktop/cdrom.desktop \"Mount default\"\n"
"             // Mounts the CDROM\n"
"\n"
msgstr ""
"*** उदाहरन:\n"
"  kioclient exec file:/root/Desktop/cdrom.desktop \"Mount default\"\n"
"             // सीडी रोम ल माउन्ट करथे \n"
"\n"

#: kioclient.cpp:114
msgid ""
"  kioclient exec file:/home/weis/data/test.html\n"
"             // Opens the file with default binding\n"
"\n"
msgstr ""
"  kioclient exec file:/home/weis/data/test.html\n"
"             // फाइल ल डिफाल्ट बाइंडिंग के साथ खोलथे \n"
"\n"

#: kioclient.cpp:116
msgid ""
"  kioclient exec file:/home/weis/data/test.html Netscape\n"
"             // Opens the file with netscape\n"
"\n"
msgstr ""
"  kioclient exec file:/home/weis/data/test.html Netscape\n"
"             // फाइल ल नेटस्केप के साथ खोलथे \n"
"\n"

#: kioclient.cpp:118
msgid ""
"  kioclient exec ftp://localhost/\n"
"             // Opens new window with URL\n"
"\n"
msgstr ""
"  kioclient exec ftp://localhost/\n"
"             // यूआरएल के साथ नवा विंडो खोलथे \n"
"\n"

#: kioclient.cpp:120
msgid ""
"  kioclient exec file:/root/Desktop/emacs.desktop\n"
"             // Starts emacs\n"
"\n"
msgstr ""
"  kioclient exec file:/root/Desktop/emacs.desktop\n"
"             // ईमैक्स खोलथे \n"
"\n"

#: kioclient.cpp:122
msgid ""
"  kioclient exec file:/root/Desktop/cdrom.desktop\n"
"             // Opens the CDROM's mount directory\n"
"\n"
msgstr ""
"  kioclient exec file:/root/Desktop/cdrom.desktop\n"
"             // सीडी राम के माउन्ट डिरेक्टरी ल खोलथे \n"
"\n"

#: kioclient.cpp:124
msgid ""
"  kioclient exec .\n"
"             // Opens the current directory. Very convenient.\n"
"\n"
msgstr ""
"  kioclient exec .\n"
"             // अभी हाल के डिरेक्टरी ल खोलथे. बहुत ही सुविधाजनक.\n"
"\n"

