#: kdessh.cpp:60
msgid "KDE ssh"
msgstr "केडीई एसएसएच"

#: kdessh.cpp:61
msgid "Runs a program on a remote host"
msgstr "रिमोट होस्ट मं प्रोग्राम चलाथे "

#: kdessh.cpp:63
msgid "Copyright (c) 2000 Geert Jansen"
msgstr "कापीराइट (c) 2000 गीर्त जानसन"

#: kdessh.cpp:65
msgid "Geert Jansen"
msgstr "गीर्त जानसन"

#: kdessh.cpp:65
msgid "Maintainer"
msgstr "मेंटेनर"

#: kdessh.cpp:71
msgid "Specifies the remote host"
msgstr "रिमोट होस्ट निरधारित करव"

#: kdessh.cpp:72
msgid "The command to run"
msgstr "चलाय बर कमांड"

#: kdessh.cpp:73
msgid "Specifies the target uid"
msgstr "लक्छ्य uid निरधारित करथे ."

#: kdessh.cpp:74
msgid "Specify remote stub location"
msgstr "रिमोट उप-जगह निरधारित करव"

#: kdessh.cpp:75
msgid "Do not keep password"
msgstr "पासवर्ड रखे नइ रहें"

#: kdessh.cpp:76
msgid "Stop the daemon (forgets all passwords)"
msgstr "डेमन ल बन्द करथे  ( सब्बो पासवर्ड भूलथे )"

#: kdessh.cpp:77
msgid "Enable terminal output (no password keeping)"
msgstr "टर्मिनल आउटपुट सक्छम करव (कोई पासवर्ड नइ रखव)"

#: kdessh.cpp:109
msgid "No command or host specified."
msgstr "कोई कमांड या होस्ट निरधारित नइ."

#: kdessh.cpp:180
msgid ""
"Ssh returned with an error.\n"
"The error message is:\n"
"\n"
msgstr ""
"एसएसएच ह एक गलती लौटाई.\n"
"गलती संदेस हे:\n"
"\n"

#: kdessh.cpp:191
msgid "Command"
msgstr "कमांड"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "रविसंकर सिरीवास्तव, जी. करूनाकर"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "raviratlami@aol.in"

#: sshdlg.cpp:56
msgid "The action you requested needs authentication. Please enter "
msgstr "काम जऊन आप मन आवेदित के हे, प्रमानीकरन चाहथे . किरपा करके, भरव"

#: sshdlg.cpp:76
msgid "Conversation with ssh failed.\n"
msgstr "एसएसएच के साथ गोठ फेल.\n"

#: sshdlg.cpp:85
msgid ""
"The programs 'ssh' or 'kdesu_stub' cannot be found.\n"
"Make sure your PATH is set correctly."
msgstr ""
"प्रोग्राम `ssh' या `kdesu_stub` नइ मिलिस!\n"
"सुनिस्चित करव कि आप मन के रस्ता उचित किसम से सेट हे."

#: sshdlg.cpp:91
msgid "Incorrect password. Please try again."
msgstr "गलत पासवर्ड! किरपा करके, फिर से  कोसिस करव."

#: sshdlg.cpp:95
msgid "Internal error: Illegal return from SshProcess::checkInstall()"
msgstr "अंदर के गलती: से अवैध वापसीः SuProcess::checkInstall()"
