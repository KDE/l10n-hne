#: volumeslider.cpp:42 volumeslider.cpp:60 volumeslider.cpp:189
#: volumeslider.cpp:204
#, qt-format
msgid "Volume: %1%"
msgstr "अवाज निर्धारक: %1%"

#: volumeslider.cpp:45 volumeslider.cpp:63 volumeslider.cpp:117
#, qt-format
msgid ""
"Use this slider to adjust the volume. The leftmost position is 0%, the "
"rightmost is %1%"
msgstr ""
"ये स्लाइडर के परयोग अवाज ल निरधारित करे बर करव. सबसे डेरी तरफ 0% हे, सबसे दाईँ ओर हे %"
"1%"

#: volumeslider.cpp:184
msgid "Muted"
msgstr "मौन"

#: audiooutput.cpp:377
#, qt-format
msgid ""
"<html>The audio playback device <b>%1</b> does not work.<br/>Falling back to "
"<b>%2</b>.</html>"
msgstr ""
"<html>आडियो प्लेबैक उपकरन <b>%1</b> काम नइ करत हे.<br/> <b>%2</b> मं फालबैक होवत हे."
"</html>"

#: audiooutput.cpp:390
#, qt-format
msgid ""
"<html>Switching to the audio playback device <b>%1</b><br/>which just became "
"available and has higher preference.</html>"
msgstr ""
"<html>आडियो प्लैबैक उपकरन <b>%1</b><br/> मं स्विच करत हे जऊन कि अभी मिलत होही अउ "
"जेमां जादा प्राथमिकता हे.</html>"

#: audiooutput.cpp:393
#, qt-format
msgid "Revert back to device '%1'"
msgstr "उपकरन '%1' मं वापस जाव"

