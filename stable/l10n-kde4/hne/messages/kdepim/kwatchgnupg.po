#: kwatchgnupgmainwin.cpp:156
msgid ""
"The watchgnupg logging process could not be started.\n"
"Please install watchgnupg somewhere in your $PATH.\n"
"This log window is now completely useless."
msgstr ""

#: kwatchgnupgmainwin.cpp:158
#, kde-format
msgid "[%1] Log started"
msgstr "[%1] लाग सुरू"

#: kwatchgnupgmainwin.cpp:193
msgid "There are no components available that support logging."
msgstr "इहां कोनो अवयव नइ मिलत हे जऊन लागिंग के समर्थन करथे ."

#: kwatchgnupgmainwin.cpp:199
msgid ""
"The watchgnupg logging process died.\n"
"Do you want to try to restart it?"
msgstr ""
"वाच-ग्नू-पीजी लागिंग काम बन्द.\n"
"का आप मन एला फिर से चालू करना चाहू?"

#: kwatchgnupgmainwin.cpp:199
msgid "Try Restart"
msgstr "फिर से चालू करके देखव"

#: kwatchgnupgmainwin.cpp:199
msgid "Do Not Try"
msgstr "कोसिस नइ करव"

#: kwatchgnupgmainwin.cpp:200
msgid "====== Restarting logging process ====="
msgstr "====== लागिंग काम चालू करत हे  ======"

#: kwatchgnupgmainwin.cpp:203
msgid ""
"The watchgnupg logging process is not running.\n"
"This log window is now completely useless."
msgstr ""
"वाच-ग्नू-पीजी लागिंग काम चलत नइ हे.\n"
"ये लाग विंडो अब पूरात: अनुपयोगी हे."

#: kwatchgnupgmainwin.cpp:234
msgid "Save Log to File"
msgstr "लाग ल फाइल मं सहेजव"

#: kwatchgnupgmainwin.cpp:239
#, kde-format
msgid ""
"The file named \"%1\" already exists. Are you sure you want to overwrite it?"
msgstr ""
"फाइल नाम \"%1\"  पहिली से ही अस्तित्व मं हे. का आप मन एखर ऊपर ही मेटाय के लिखना चाहू?"

#: kwatchgnupgmainwin.cpp:242
msgid "Overwrite File"
msgstr "फाइल के ऊपर लिखव"

#: kwatchgnupgmainwin.cpp:249
#, kde-format
msgid "Could not save file %1: %2"
msgstr "फाइल ल सहेज नइ सकिस %1: %2"

