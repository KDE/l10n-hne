#: plugin_katetextfilter.cpp:153
msgid ""
"You are not allowed to execute arbitrary external applications. If you want "
"to be able to do this, contact your system administrator."
msgstr ""
"आप कोनो अउ बाहिरी अनुपरयोग मन ल चलाय बर अधिकृत नइ हे. यदि आप मन एला सक्छम करना "
"चाहथो तहां अपन तंत्र प्रसासक से संपर्क करव."

#: plugin_katetextfilter.cpp:155
msgid "Access Restrictions"
msgstr "पहुंच मं रोक"

#: plugin_katetextfilter.cpp:165
msgid "Filter"
msgstr "फिल्टर"

#: plugin_katetextfilter.cpp:165
msgid "Enter command to pipe selected text through:"
msgstr "चुने गे पाठ ल पाइप करे बर कमांड भरव:"

#: plugin_katetextfilter.cpp:204
msgid ""
"<qt><p>Usage: <code>textfilter COMMAND</code></p><p>Replace the selection "
"with the output of the specified shell command.</p></qt>"
msgstr ""
"<qt><p>उपयोग: <code>textfilter COMMAND</code></p><p>चयन ल निरधारित सैल कमांड के "
"आउटपुट से बदलव.</p></qt>"

#: plugin_katetextfilter.cpp:213
msgid "You need to have a selection to use textfilter"
msgstr "टैक्स्ट छनइया परयोग करे बर आप मन ल कुछु चुनना होही"

#: plugin_katetextfilter.cpp:221
msgid "Usage: textfilter COMMAND"
msgstr "उपयोग: textfilter COMMAND"

