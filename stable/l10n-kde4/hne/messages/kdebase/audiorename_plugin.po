#: audio_plugin.cpp:72
#, kde-format
msgid "An older file named '%1' already exists.\n"
msgstr "एक जुन्ना फाइल '%1' के नाम से पहिली से ही अस्तित्व मं हे. \n"

#: audio_plugin.cpp:74
#, kde-format
msgid "A similar file named '%1' already exists.\n"
msgstr "एक अइसने फाइल '%1' के नाम से  पहिली से ही अस्तित्व मं हे. \n"

#: audio_plugin.cpp:76
#, kde-format
msgid "A newer file named '%1' already exists.\n"
msgstr "एक नवा फाइल '%1' के नाम से  पहिली से ही अस्तित्व मं हे. \n"

#: audio_plugin.cpp:78
msgid "Source File"
msgstr "स्रोत फाइल"

#: audio_plugin.cpp:79
msgid "Existing File"
msgstr "अभी हाल के फाइल"

#: audio_plugin.cpp:80
msgid "Would you like to replace the existing file with the one on the right?"
msgstr "का आप मन अभी हाल के फाइल ल जेवनी मं दे गे फाइल से बदलना चाहू?"

#: audiopreview.cpp:51
msgid ""
"This audio file is not stored\n"
"on the local host.\n"
"Click on this label to load it.\n"
msgstr ""
"ये आडियो फाइल लोकल होस्ट म\n"
"भंडारित नइ हे.\n"
"लोड करे बर एखर लेबल मं किलिक करव.\n"

#: audiopreview.cpp:57
msgid "Unable to load audio file"
msgstr "आडियो फाइल लोड करे मं अक्छम"

