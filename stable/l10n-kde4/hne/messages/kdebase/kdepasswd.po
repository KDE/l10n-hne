#: kdepasswd.cpp:41
msgid "KDE passwd"
msgstr "केडीई पासवर्ड"

#: kdepasswd.cpp:42
msgid "Changes a UNIX password."
msgstr "यूनिक्स पासवर्ड बदलथे."

#: kdepasswd.cpp:43
msgid "Copyright (c) 2000 Geert Jansen"
msgstr "कापीराइट (c) 2000 गीर्त जानसन"

#: kdepasswd.cpp:44
msgid "Geert Jansen"
msgstr "गीर्त जानसन"

#: kdepasswd.cpp:44
msgid "Maintainer"
msgstr "मेंटेनर"

#: kdepasswd.cpp:51
msgid "Change password of this user"
msgstr "ये कमइया के पासवर्ड बदलव."

#: kdepasswd.cpp:74
msgid "You need to be root to change the password of other users."
msgstr "अऊ दूसर कमइया के पासवर्ड बदले बर आप मन ल रूट होना होही."

#: passwddlg.cpp:34 passwddlg.cpp:101
msgid "Change Password"
msgstr "पासवर्ड बदलव"

#: passwddlg.cpp:35
msgid "Please enter your current password:"
msgstr "किरपा करके, अपन अभी हाल के पासवर्ड भरव:"

#: passwddlg.cpp:55 passwddlg.cpp:179
msgid "Conversation with 'passwd' failed."
msgstr "`passwd' के साथ गोठ फेल."

#: passwddlg.cpp:65
msgid "Could not find the program 'passwd'."
msgstr "प्रोग्राम `passwd' नइ मिलिस."

#: passwddlg.cpp:70
msgid "Incorrect password. Please try again."
msgstr "गलत पासवर्ड! किरपा करके, फिर से  कोसिस करव."

#: passwddlg.cpp:74
msgid "Internal error: illegal return value from PasswdProcess::checkCurrent."
msgstr "अंदर के गलतीः PasswdProcess::checkCurrent से मूल्य अवैध वापिस होइस."

#: passwddlg.cpp:103
msgid "Please enter your new password:"
msgstr "किरपा करके, अपन नवा पासवर्ड भरव."

#: passwddlg.cpp:105
#, kde-format
msgid "Please enter the new password for user <b>%1</b>:"
msgstr "कमइया <b>%1</b>  बर किरपा करके, नवा पासवर्ड भरव:"

#: passwddlg.cpp:127
msgid ""
"Your password is longer than 8 characters. On some systems, this can cause "
"problems. You can truncate the password to 8 characters, or leave it as it "
"is."
msgstr ""
"आप मन के पासवर्ड 8 अक्छर से बड़ा हे. कुछ तंत्र मं ये समस्या पैदा कर सकथे. आप मन पासवर्ड ल 8 "
"अक्छर तक समेट सकथो या एला वइसनेच रहन देव जइसन ये हे."

#: passwddlg.cpp:130
msgid ""
"The password is longer than 8 characters. On some systems, this can cause "
"problems. You can truncate the password to 8 characters, or leave it as it "
"is."
msgstr ""
"आप मन के पासवर्ड 8 अक्छर से बड़ा हे. कुछ तंत्रों मं ये समस्या पैदा कर सकथे. आप मन पासवर्ड ल "
"8 अक्छर तक समेट सकथो या एला वइसनेच रहन देव जइसन ए हे."

#: passwddlg.cpp:134
msgid "Password Too Long"
msgstr "पासवर्ड बहुत लंबा हे"

#: passwddlg.cpp:135
msgid "Truncate"
msgstr "छोटा करव"

#: passwddlg.cpp:136
msgid "Use as Is"
msgstr "जइसन हे, उपयोग करव"

#: passwddlg.cpp:158
msgid "Your password has been changed."
msgstr "आप मन के पासवर्ड बदले गिस."

#: passwddlg.cpp:168
msgid "Your password has not been changed."
msgstr "आप मन के पासवर्ड नइ बदले गिस."

