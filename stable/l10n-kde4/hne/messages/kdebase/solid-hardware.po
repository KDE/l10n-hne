#: solid-hardware.cpp:45
msgid "solid-hardware"
msgstr "सालिड-हार्डवेयर"

#: solid-hardware.cpp:47
#| msgid ""
#| "KDE tool for querying and controlling your hardware from the command line"
msgid "KDE tool for querying your hardware from the command line"
msgstr "कमांड लाइन से आप मन के हार्डवेयर ल क्वैरी करे बर केडीई औजार"

#: solid-hardware.cpp:159
msgid "Syntax Error: Not enough arguments"
msgstr "सिंटेक्स गलती: बहुत आर्गुमेंट नइ"

#: solid-hardware.cpp:165
msgid "Syntax Error: Too many arguments"
msgstr "सिंटेक्स गलती: बहुत से आर्गुमेंट"

#: solid-hardware.cpp:177
#| msgid "Show available commands by domains"
msgid "Show available commands"
msgstr "मिलत कमांड देखाव"

#: solid-hardware.cpp:179
msgid "Command (see --commands)"
msgstr "कमांड (देखव --कमांड)"

#: solid-hardware.cpp:181
msgid "Arguments for command"
msgstr "कमांड बर आर्गुमेंट्स"

#: solid-hardware.cpp:193
msgid "Syntax:"
msgstr "सिंटेक्स:"

#: solid-hardware.cpp:196
msgid ""
"             # List the hardware available in the system.\n"
"             # - If the 'nonportableinfo' option is specified, the device\n"
"             # properties are listed (be careful, in this case property "
"names\n"
"             # are backend dependent),\n"
"             # - If the 'details' option is specified, the device "
"interfaces\n"
"             # and the corresponding properties are listed in a platform\n"
"             # neutral fashion,\n"
"             # - Otherwise only device UDIs are listed.\n"
msgstr ""

#: solid-hardware.cpp:206
msgid ""
"             # Display all the interfaces and properties of the device\n"
"             # corresponding to 'udi' in a platform neutral fashion.\n"
msgstr ""

#: solid-hardware.cpp:210
msgid ""
"             # Display all the properties of the device corresponding to "
"'udi'\n"
"             # (be careful, in this case property names are backend "
"dependent).\n"
msgstr ""

#: solid-hardware.cpp:214
msgid ""
"             # List the UDI of devices corresponding to 'predicate'.\n"
"             # - If 'parentUdi' is specified, the search is restricted to "
"the\n"
"             # branch of the corresponding device,\n"
"             # - Otherwise the search is done on all the devices.\n"
msgstr ""

#: solid-hardware.cpp:220
msgid "             # If applicable, mount the device corresponding to 'udi'.\n"
msgstr "             # यदि लागू हो, उपकरन ल 'यूडीआई' के अनुसार माउन्ट करव.\n"

#: solid-hardware.cpp:223
msgid "             # If applicable, unmount the device corresponding to 'udi'.\n"
msgstr "             # यदि लागू हो, उपकरन ल 'यूडीआई' के अनुसार अनमाउन्ट करव.\n"

#: solid-hardware.cpp:226
msgid "             # If applicable, eject the device corresponding to 'udi'.\n"
msgstr "             # यदि लागू हो, उपकरन ल 'यूडीआई' के अनुसार बाहिर करव.\n"

#: solid-hardware.cpp:297
#, kde-format
msgid "Syntax Error: Unknown command '%1'"
msgstr "सिंटेक्स गलती: अग्यात कमांड '%1'"

#: solid-hardware.cpp:367
#, kde-format
msgid "Error: %1 does not have the interface StorageAccess."
msgstr "गलती: %1 मं इंटरफेस स्टोरेज एक्सेस नइ हे."

#: solid-hardware.cpp:372
#, kde-format
msgid "Error: %1 does not have the interface OpticalDrive."
msgstr "गलती: %1 मं इंटरफेस आप्टिकल ड्राइव नइ हे."

