#: kde-menu.cpp:93
#, kde-format
msgid "Menu item '%1' could not be highlighted."
msgstr "मेन्यू आइटम  '%1' ल चमका नइ सकिस."

#: kde-menu.cpp:106
msgid ""
"KDE Menu query tool.\n"
"This tool can be used to find in which menu a specific application is "
"shown.\n"
"The --highlight option can be used to visually indicate to the user where\n"
"in the KDE menu a specific application is located."
msgstr ""

#: kde-menu.cpp:111
msgid "kde-menu"
msgstr "केडीई-मेन्यू"

#: kde-menu.cpp:113
msgid "(c) 2003 Waldo Bastian"
msgstr "(c) 2003 वाल्दो बास्तियान"

#: kde-menu.cpp:114
msgid "Waldo Bastian"
msgstr "वाल्दो बास्तियान"

#: kde-menu.cpp:114
msgid "Author"
msgstr "लेखक"

#: kde-menu.cpp:119
msgid "Output data in UTF-8 instead of local encoding"
msgstr "आउटपुट डाटा यूटीएफ-8 मं, बदला मा लोकल एनकोडिंग के"

#: kde-menu.cpp:120
msgid ""
"Print menu-id of the menu that contains\n"
"the application"
msgstr ""
"मेन्यू के मेन्यू-आईडी छापव जेमां कि\n"
"अनुपरयोग हे."

#: kde-menu.cpp:121
msgid ""
"Print menu name (caption) of the menu that\n"
"contains the application"
msgstr ""
"ओ मेन्यू (कैप्सन) के नाम छापव\n"
"जेमां अनुपरयोग हे."

#: kde-menu.cpp:122
msgid "Highlight the entry in the menu"
msgstr "मेन्यू मं प्रविस्टि ल चमकाव"

#: kde-menu.cpp:123
msgid "Do not check if sycoca database is up to date"
msgstr "सिकोका डाटाबेस अपडेट होही तहां नइ जांचव"

#: kde-menu.cpp:124
msgid "The id of the menu entry to locate"
msgstr "मेन्यू एन्ट्री ल लोकेट करे के आईडी."

#: kde-menu.cpp:133
msgid "You must specify an application-id such as 'kde4-konsole.desktop'"
msgstr ""
"आप मन ल एक अनुपरयोग आई-डी निरधारित करना होही जइसन कि - 'kde4-konsole.desktop'"

#: kde-menu.cpp:142
msgid ""
"You must specify at least one of --print-menu-id, --print-menu-name or --"
"highlight"
msgstr ""
"आप मन ल एमां से कोनो एक ल निरधारित करना होही --print-menu-id, --print-menu-"
"name या --highlight"

#: kde-menu.cpp:164
#, kde-format
msgid "No menu item '%1'."
msgstr "कोई मेन्यू आइटम नइ '%1'."

#: kde-menu.cpp:168
#, kde-format
msgid "Menu item '%1' not found in menu."
msgstr "मेन्यू आइटम  '%1' मेन्यू मं नइ मिलिस."

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "रविसंकर सिरीवास्तव, जी. करूनाकर"

