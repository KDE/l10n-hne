#: kio_floppy.cpp:199
#, kde-format
msgid ""
"Could not access drive %1.\n"
"The drive is still busy.\n"
"Wait until it is inactive and then try again."
msgstr ""
"ड्राइव %1 मं पहुंच नइ सकिस.\n"
"ड्राइव अभी व्यस्त हे.\n"
"एखर काम पूरा होवत तक अगोरव अउ फिर से  कोसिस करव. "

#: kio_floppy.cpp:203 kio_floppy.cpp:1115
#, kde-format
msgid ""
"Could not write to file %1.\n"
"The disk in drive %2 is probably full."
msgstr ""
"फाइल %1 मं लिख नइ सकिस.\n"
"हो सकथे ड्राइव मं डिस्क %2 पूरा भर गे हे"

#: kio_floppy.cpp:213
#, kde-format
msgid ""
"Could not access %1.\n"
"There is probably no disk in the drive %2"
msgstr ""
"%1 मं पहुंच नइ सकिस.\n"
"हो सकथे ड्राइव %2 मं कोनो डिस्क नइ हे"

#: kio_floppy.cpp:217
#, kde-format
msgid ""
"Could not access %1.\n"
"There is probably no disk in the drive %2 or you do not have enough "
"permissions to access the drive."
msgstr ""
"%1 मं पहुंच नइ सकिस.\n"
"हो सकथे ड्राइव %2 मं कोनो डिस्क नइ हे या आप मन तिर ओ ड्राइव मं पहुंच के पूरा अनुमति नइ हे."

#: kio_floppy.cpp:221
#, kde-format
msgid ""
"Could not access %1.\n"
"The drive %2 is not supported."
msgstr ""
"%1 मं पहुंच नइ सकिस.\n"
"हो सकथे ड्राइव %2 समर्थित नइ हे."

#: kio_floppy.cpp:226
#, kde-format
msgid ""
"Could not access %1.\n"
"Make sure the floppy in drive %2 is a DOS-formatted floppy disk \n"
"and that the permissions of the device file (e.g. /dev/fd0) are set "
"correctly (e.g. rwxrwxrwx)."
msgstr ""
"%1 मं पहुंच नइ सकिस.\n"
"किरपा करके, देख लेव कि  ड्राइव %2 के फ्लापी एक डास फार्मेटेड फ्लापी डिस्क हे \n"
"तथा उपकरन फाइल (जइसन कि /dev/fd0) के अनुमति उचित किसम सेट हे(जइसन कि- rwxrwxrwx)."

#: kio_floppy.cpp:230
#, kde-format
msgid ""
"Could not access %1.\n"
"The disk in drive %2 is probably not a DOS-formatted floppy disk."
msgstr ""
"फाइल %1 मं लिख नइ सकिस.\n"
"ड्राइव मं डिस्क %2 संभवत: डास फार्मेटेड फ्लापी डिस्क नइ हे."

#: kio_floppy.cpp:234
#, kde-format
msgid ""
"Access denied.\n"
"Could not write to %1.\n"
"The disk in drive %2 is probably write-protected."
msgstr ""
"पहुंच अस्वीकृत.\n"
"%1 मं लिख नइ सकिस.\n"
"हो सकथे ड्राइव %2 मं लिखे से रोक लगी हो गे हे."

#: kio_floppy.cpp:243
#, kde-format
msgid ""
"Could not read boot sector for %1.\n"
"There is probably not any disk in drive %2."
msgstr ""
" %1 के बूट सेक्टर पढ़ नइ सकिस.\n"
"हो सकथे ड्राइव %2 तिर कोनो डिस्क नइ हे."

#: kio_floppy.cpp:366
#, kde-format
msgid ""
"Could not start program \"%1\".\n"
"Ensure that the mtools package is installed correctly on your system."
msgstr ""
"प्रोग्राम \"%1\" ल चालू नइ हो सकिस.\n"
"सुनिस्चित करव कि एमटूल पैकेज आप मन के तंत्र मं उचित किसम इनस्टाल हे."
