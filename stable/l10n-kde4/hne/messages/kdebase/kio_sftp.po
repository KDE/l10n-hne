#: kio_sftp.cpp:428
msgid "An internal error occurred. Please retry the request again."
msgstr "एक अंदर के गलती होइस. किरपा करके, फिर से निवेदन करव."

#: kio_sftp.cpp:511
#, kde-format
#| msgid "Opening SFTP connection to host <b>%1:%2</b>"
msgid "Opening SFTP connection to host %1:%2"
msgstr "होस्ट %1:%2 से एसएफटीपी कनेक्सन खोलत हे"

#: kio_sftp.cpp:515
msgid "No hostname specified"
msgstr "कोई होस्टनाम निरधारित नइ हे"

#: kio_sftp.cpp:527
msgid "SFTP Login"
msgstr "एसएफटीपी लागइन"

#: kio_sftp.cpp:529
msgid "site:"
msgstr "साइटः"

#: kio_sftp.cpp:633
msgid "Please enter your username and key passphrase."
msgstr "किरपा करके, अपन कमइया-नाम अउ कुंजी पासफ्रेस भरव"

#: kio_sftp.cpp:635
msgid "Please enter your username and password."
msgstr "किरपा करके, अपन कमइया-नाम अउ पासवर्ड भरव."

#: kio_sftp.cpp:643
msgid "Incorrect username or password"
msgstr "गलत कमइया-नाम या पासवर्ड "

#: kio_sftp.cpp:648
msgid "Please enter a username and password"
msgstr "किरपा करके, एक कमइया-नाम अउ पासवर्ड भरव."

#: kio_sftp.cpp:709
msgid "Warning: Cannot verify host's identity."
msgstr "चेतावनीः होस्ट के परिचय सत्यापित नइ कर सकीस."

#: kio_sftp.cpp:720
msgid "Warning: Host's identity changed."
msgstr "चेतावनीः होस्ट के परिचय बदल दे गे हे."

#: kio_sftp.cpp:731 kio_sftp.cpp:732
msgid "Authentication failed."
msgstr "प्रमानीकरन फेल"

#: kio_sftp.cpp:746 kio_sftp.cpp:761
msgid "Connection failed."
msgstr "कनेक्सन फेल."

#: kio_sftp.cpp:747 ksshprocess.cpp:868 ksshprocess.cpp:1015
msgid "Connection closed by remote host."
msgstr "रिमोट होस्ट से कनेक्सन बन्द करिस."

#: kio_sftp.cpp:762
#, kde-format
msgid "Unexpected SFTP error: %1"
msgstr "अप्रत्यासित एसएफटीपी गलती: %1"

#: kio_sftp.cpp:806
#, kde-format
msgid "SFTP version %1"
msgstr "एसएफटीपी संस्करन %1"

#: kio_sftp.cpp:812
msgid "Protocol error."
msgstr "प्रोटोकाल गलती."

#: kio_sftp.cpp:818
#, kde-format
msgid "Successfully connected to %1"
msgstr "%1 से सफलता से जुड़िस"

#: kio_sftp.cpp:1178
msgid "An internal error occurred. Please try again."
msgstr "अंदर के गलती होइस. किरपा करके, फिर कोसिस करव."

#: kio_sftp.cpp:1199
#, kde-format
msgid ""
"Unknown error was encountered while copying the file to '%1'. Please try "
"again."
msgstr "फाइल ल '%1' मं नकल करे के समय अग्यात गलती होइस. किरपा करके, फिर कोसिस करव."

#: kio_sftp.cpp:1436
msgid "The remote host does not support renaming files."
msgstr "रिमोट होस्ट फाइल नाम बदले बर समर्थित नइ करे."

#: kio_sftp.cpp:1485
msgid "The remote host does not support creating symbolic links."
msgstr "रिमोट होस्ट सिंबालिक संकली तैयार करे बर समर्थन नइ करे."

#: kio_sftp.cpp:1620
msgid "Connection closed"
msgstr "कनेक्सन बन्द"

#: kio_sftp.cpp:1622
msgid "Could not read SFTP packet"
msgstr "एसएफटीपी पैकेट पढ़ नइ सकीस"

#: kio_sftp.cpp:1735
msgid "End of file."
msgstr "फाइल के आखरी."

#: kio_sftp.cpp:1738
msgid "File does not exist."
msgstr "फाइल मौजूद नइ हे."

#: kio_sftp.cpp:1742
msgid "Access is denied."
msgstr "पंहुच अस्वीकृत."

#: kio_sftp.cpp:1746
msgid "SFTP command failed for an unknown reason."
msgstr "अग्यात कारन से एसएफटीपी कमांड फेल."

#: kio_sftp.cpp:1750
msgid "The SFTP server received a bad message."
msgstr "एसएफटीपी सर्वर ल खराब संदेस प्राप्त."

#: kio_sftp.cpp:1754
msgid "You attempted an operation unsupported by the SFTP server."
msgstr "आप मन के साथ एसएफटीपी सर्वर से असमर्थित आपरेसन चाहे गिस."

#: kio_sftp.cpp:1758
#, kde-format
msgid "Error code: %1"
msgstr "गलती कोडः %1"

#: ksshprocess.cpp:460
msgid "Cannot specify a subsystem and command at the same time."
msgstr "एक ही समय मं एक सब-सिसटम अउ कमांड निरधारित नइ कर सके."

#: ksshprocess.cpp:801
msgid "No options provided for ssh execution."
msgstr "एसएसएच चलाय बर कोनो विकल्प नइ दे गे हे."

#: ksshprocess.cpp:809
msgid "Failed to execute ssh process."
msgstr "एसएसएच काम ल चलाय मं फेल."

#: ksshprocess.cpp:834 ksshprocess.cpp:863 ksshprocess.cpp:982
#: ksshprocess.cpp:1054
msgid "Error encountered while talking to ssh."
msgstr "एसएसएच से बात करे मं गलती होइस."

#: ksshprocess.cpp:914
msgid "Please supply a password."
msgstr "किरपा करके, पासवर्ड भरव."

#: ksshprocess.cpp:953
msgid "Please supply the passphrase for your SSH private key."
msgstr "किरपा करके, अपन एसएसएच निजी कुंजी बर पासफ्रेस देव."

#: ksshprocess.cpp:967
#, kde-format
msgid "Authentication to %1 failed"
msgstr "%1 से प्रमानीकरन मं फेल"

#: ksshprocess.cpp:990
#, kde-format
msgid ""
"The identity of the remote host '%1' could not be verified because the "
"host's key is not in the \"known hosts\" file."
msgstr ""
"रिमोट होस्ट '%1' के पहचान सत्यापित नइ कर सकीस काबर कि होस्ट कुंजी \"known hosts\" "
"फाइल मं नइ हे."

#: ksshprocess.cpp:996
msgid ""
" Manually, add the host's key to the \"known hosts\" file or contact your "
"administrator."
msgstr ""
"होस्ट कुंजी हाथ से ही \"known hosts\" फाइल मं जोड़व या अपन तंत्र प्रसासक से संपर्क करव."

#: ksshprocess.cpp:1002
#, kde-format
msgid " Manually, add the host's key to %1 or contact your administrator."
msgstr "होस्ट कुंजी हाथ से ही %1 मं जोड़व या अपन तंत्र प्रसासक से संपर्क करव."

#: ksshprocess.cpp:1034
#, kde-format
msgid ""
"The identity of the remote host '%1' could not be verified. The host's key "
"fingerprint is:\n"
"%2\n"
"You should verify the fingerprint with the host's administrator before "
"connecting.\n"
"\n"
"Would you like to accept the host's key and connect anyway? "
msgstr ""

#: ksshprocess.cpp:1062
#, kde-format
msgid ""
"WARNING: The identity of the remote host '%1' has changed!\n"
"\n"
"Someone could be eavesdropping on your connection, or the administrator may "
"have just changed the host's key. Either way, you should verify the host's "
"key fingerprint with the host's administrator. The key fingerprint is:\n"
"%2\n"
"Add the correct host key to \"%3\" to get rid of this message."
msgstr ""

#: ksshprocess.cpp:1097
#, kde-format
msgid ""
"WARNING: The identity of the remote host '%1' has changed!\n"
"\n"
"Someone could be eavesdropping on your connection, or the administrator may "
"have just changed the host's key. Either way, you should verify the host's "
"key fingerprint with the host's administrator before connecting. The key "
"fingerprint is:\n"
"%2\n"
"\n"
"Would you like to accept the host's new key and connect anyway?"
msgstr ""

#: ksshprocess.cpp:1121
msgid "Host key was rejected."
msgstr "होस्ट कुंजी अस्वीकृत."

