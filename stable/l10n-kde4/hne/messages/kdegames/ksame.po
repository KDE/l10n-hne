#: board.cpp:403
#, kde-format
msgid ""
"You won.\n"
"You even removed the last stone, great job!\n"
" Your score was %1."
msgstr ""
"आप मन जीत गेव.\n"
"आप मन आखरी पथरा ल घलोक हटा देव. बढ़िया काम करे हव!\n"
" आप मन के अंक हे %1."

#: board.cpp:405
#, kde-format
msgid ""
"Game over.\n"
"There are no more removable stones.\n"
" Your score was %1."
msgstr ""
"खेल खतम.\n"
"अब इहां हटाय जा सके अइसन कोनो पथरा नइ हे.\n"
" आप मन के अंक हे %1."

#: main.cpp:31
msgid ""
"Same Game\n"
"A little game about balls and how to get rid of them"
msgstr ""
"सेम गेम\n"
"गेंद अउ ओ मन से छुटकारा पाय के एक छोटकुन खेल."

