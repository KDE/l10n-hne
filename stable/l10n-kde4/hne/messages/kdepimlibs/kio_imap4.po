#: imap4.cpp:614
#, kde-format
msgid "Message from %1 while processing '%2': %3"
msgstr "%1 से संदेस, ए काम के समय- '%2': %3"

#: imap4.cpp:616
#, kde-format
msgid "Message from %1: %2"
msgstr " %1 से संदेस: %2"

#: imap4.cpp:940
#, kde-format
msgid ""
"The following folder will be created on the server: %1 What do you want to "
"store in this folder?"
msgstr ""
"सर्वर: %1 मं नीचे वाले फोल्डर बनाय जाही. ए फोल्डर मं आप मन के भंडारित करना चाहथो ?"

#: imap4.cpp:942
msgid "Create Folder"
msgstr "फोल्डर बनाव"

#: imap4.cpp:943
msgid "&Messages"
msgstr "संदेस (&M)"

#: imap4.cpp:943
msgid "&Subfolders"
msgstr "उप-फोल्डर (&S)"

#: imap4.cpp:1277
#, kde-format
msgid "Unsubscribe of folder %1 failed. The server returned: %2"
msgstr "फोल्डर %1 अनसब्सक्राइब करे मं फेल. सर्वर हर लहुटाइसः %2"

#: imap4.cpp:1298
#, kde-format
msgid "Subscribe of folder %1 failed. The server returned: %2"
msgstr "फोल्डर %1 सब्सक्राइब करे मं फेल. सर्वर हर लहुटाइसः %2"

#: imap4.cpp:1367
#, kde-format
msgid "Changing the flags of message %1 failed with %2."
msgstr "संदेस %1 के फ्लैग बदले जाना %2 के साथ फेल होइस."

#: imap4.cpp:1379
#, kde-format
msgid "Silent Changing the flags of message %1 failed with %2."
msgstr "संदेस %1 के फ्लैग बदले जाना %2 के साथ फेल."

#: imap4.cpp:1411
#, kde-format
msgid "Changing the flags of message %1 failed."
msgstr "संदेस %1 के फ्लैग बदले मं फेल."

#: imap4.cpp:1456
#, kde-format
msgid ""
"Setting the Access Control List on folder %1 for user %2 failed. The server "
"returned: %3"
msgstr "फोल्डर %1 मं कमइया %2 बर पहुंच नियंत्रन सेट करना फेल रहिस. सर्वर हर लहुटाइस: %3"

#: imap4.cpp:1475
#, kde-format
msgid ""
"Deleting the Access Control List on folder %1 for user %2 failed. The server "
"returned: %3"
msgstr "फोल्डर %1 मं कमइया %2 बर पहुंच नियंत्रन मिटाना फेल रहिस. सर्वर हर लहुटाइस: %3"

#: imap4.cpp:1492 imap4.cpp:1519
#, kde-format
msgid ""
"Retrieving the Access Control List on folder %1 failed. The server returned: "
"%2"
msgstr "फोल्डर %1 से पहुंच नियंत्रन सूची निकाल पाय मं फेल रहिस. सर्वर हर लहुटाइस: %2"

#: imap4.cpp:1553
#, kde-format
msgid "Searching of folder %1 failed. The server returned: %2"
msgstr "फोल्डर %1 खोजे मं फेल. सर्वर हर लहुटाइसः %2"

#: imap4.cpp:1588
#, kde-format
msgid "Custom command %1:%2 failed. The server returned: %3"
msgstr ""

#: imap4.cpp:1668
#, kde-format
msgid "Setting the annotation %1 on folder %2  failed. The server returned: %3"
msgstr "फोल्डर %2 मं एनोटेसन %1 सेट करना फेल रहिस. सर्वर हर लहुटाइस: %3"

#: imap4.cpp:1692
#, kde-format
msgid ""
"Retrieving the annotation %1 on folder %2 failed. The server returned: %3"
msgstr "फोल्डर %2 मं एनोटेसन %1 प्राप्त करना फेल रहिस. सर्वर हर लहुटाइस: %3"

#: imap4.cpp:1729
#, kde-format
msgid ""
"Retrieving the quota root information on folder %1 failed. The server "
"returned: %2"
msgstr ""
"फोल्डर %1 से रूट नियतांस (कोटा) जानकारी निकाल पाय मं फेल रहिस. सर्वर हर लहुटाइस: %2"

#: imap4.cpp:1785 imap4.cpp:1853
msgid "Unable to close mailbox."
msgstr "डाक-डब्बा बन्द करे मं अक्छम."

#: imap4.cpp:1883
#, kde-format
msgid "Unable to get information about folder %1. The server replied: %2"
msgstr "फोल्डर %1 परिचय जानकारी प्राप्त करे मं अक्छम. सर्वर हर जवाब दिस: %2"

#: imap4.cpp:2040
#, kde-format
msgid ""
"The server %1 supports neither IMAP4 nor IMAP4rev1.\n"
"It identified itself with: %2"
msgstr ""
"सर्वर %1 समर्थित नइ करथे  IMAP4 नइ ही IMAP4rev1.\n"
"ये अपने अपन के परिचय देथे : %2 से"

#: imap4.cpp:2051
msgid ""
"The server does not support TLS.\n"
"Disable this security feature to connect unencrypted."
msgstr ""
"सर्वर टीएलएस समर्थन नइ करथे .\n"
" एखर सुरक्छा ल अक्छम करव यदि आप मन बिना एनक्रिप्सन के कनेक्ट होना चाहथो ."

#: imap4.cpp:2075
msgid "Starting TLS failed."
msgstr "टीएलएस चालू करना फेल."

#: imap4.cpp:2085
#, kde-format
msgid "The authentication method %1 is not supported by the server."
msgstr "प्रामानीकरन विधि %1 सर्वर से समर्थित नइ हे."

#: imap4.cpp:2112
msgid "Username and password for your IMAP account:"
msgstr "अपन आईमैप खाता बर कमइया नाम अउ पासवर्ड:"

#: imap4.cpp:2126
#, kde-format
msgid ""
"Unable to login. Probably the password is wrong.\n"
"The server %1 replied:\n"
"%2"
msgstr ""
"लागिन मं फेल. हो सकथे पासवर्ड गलत हे.\n"
"सर्वर %1 हर जवाब दिस:\n"
"%2"

#: imap4.cpp:2132
#, kde-format
msgid ""
"Unable to authenticate via %1.\n"
"The server %2 replied:\n"
"%3"
msgstr ""
"%1 के साथ प्रमानीकरन करे मं फेल..\n"
"सर्वर %2 हर जवाब दिस:\n"
"%3"

#: imap4.cpp:2622
#, kde-format
msgid "Unable to open folder %1. The server replied: %2"
msgstr "फोल्डर %1 ल खोले मं अक्छम. सर्वर हर जवाब दिस: %2"

#~ msgid "SASL authentication is not compiled into kio_imap4."
#~ msgstr "केआईओ_पाप4 मं एसएएसएल प्रमानीकरन कम्पाइल्ड नइ करे गे हे."
