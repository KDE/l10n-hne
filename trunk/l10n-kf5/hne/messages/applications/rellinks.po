#: plugin_rellinks.cpp:64
#, kde-format
msgid "Rellinks"
msgstr "रीलिंक्स"

#: plugin_rellinks.cpp:72
#, kde-format
msgid "&Top"
msgstr "सीर्स (&T)"

#: plugin_rellinks.cpp:75
#, kde-format
msgid "<p>This link references a home page or the top of some hierarchy.</p>"
msgstr "<p>ये संकली मं घर पेज या कोनो अनुक्रम के सीर्स के संदर्भ हे.</p>"

#: plugin_rellinks.cpp:79
#, kde-format
msgid "&Up"
msgstr "ऊपर (&U)"

#: plugin_rellinks.cpp:82
#, kde-format
msgid ""
"<p>This link references the immediate parent of the current document.</p>"
msgstr "<p>ये संकली मं अभी हाल के कागद के निकटतम पेरेंट के संदर्भ हे.</p>"

#: plugin_rellinks.cpp:88
#, kde-format
msgid "&First"
msgstr "पहला (&F)"

#: plugin_rellinks.cpp:91
#, kde-format
msgid ""
"<p>This link type tells search engines which document is considered by the "
"author to be the starting point of the collection.</p>"
msgstr ""
"<p>ये संकली किसम सर्च इंजिन ल बताथे  कि संग्रह के चालू बिन्दु के रूप मं कोन से कागद लेखक के "
"साथ स्वीकार होही.</p>"

#: plugin_rellinks.cpp:95
#, kde-format
msgid "&Previous"
msgstr "पिछला (&P)"

#: plugin_rellinks.cpp:98
#, kde-format
msgid ""
"<p>This link references the previous document in an ordered series of "
"documents.</p>"
msgstr "<p>ये संकली मं कागद मन के स्रेनी के अनुक्रम के पिछले कागद के संदर्भ हे.</p>"

#: plugin_rellinks.cpp:102
#, kde-format
msgid "&Next"
msgstr "अगला (&N)"

#: plugin_rellinks.cpp:105
#, kde-format
msgid ""
"<p>This link references the next document in an ordered series of documents."
"</p>"
msgstr "<p>ये संकली मं कागद मन के स्रेनी के अनुक्रम के अगले कागद के संदर्भ हे.</p>"

#: plugin_rellinks.cpp:109
#, kde-format
msgid "&Last"
msgstr "आखरी (&L)"

#: plugin_rellinks.cpp:112
#, kde-format
msgid "<p>This link references the end of a sequence of documents.</p>"
msgstr "<p>ये संकली मं कागद मन के आखरी क्रम के संदर्भ हे.</p>"

#: plugin_rellinks.cpp:117
#, kde-format
msgid "&Search"
msgstr "खोजव (&S)"

#: plugin_rellinks.cpp:120
#, kde-format
msgid "<p>This link references the search.</p>"
msgstr " <p>ये संकली खोजे बर हे.</p>"

