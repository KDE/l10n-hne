#: katemailfiles.cpp:44
msgid "Mail Files"
msgstr "फाइल मन ल ई-मेल करव"

#: katemailfiles.cpp:44
msgid "Support mailing files"
msgstr ""

#: katemailfiles.cpp:59
msgid "Send one or more of the open documents as email attachments."
msgstr "खुले कागद मन मं से एक या अधिक ल ई-मेल अटेचमेंट के जइसन भेजव"

#: katemailfiles.cpp:90
msgid ""
"<p>The current document has not been saved, and cannot be attached to an "
"email message.</p><p>Do you want to save it and proceed?</p>"
msgstr ""
"<p>अभी हाल के कागद सहेजे नइ गे हे, अउ कोनो ई-मेल संदेस मं संलग्न नइ कर सकिस.</p><p>का "
"आप मन एला सहेज कर आगू बढ़ना चाहथो ?</p>"

#: katemailfiles.cpp:93
msgid "Cannot Send Unsaved File"
msgstr "बिना सहेजी फाइल भेजी नइ जा सके"

#: katemailfiles.cpp:101 katemailfiles.cpp:125
msgid "The file could not be saved. Please check if you have write permission."
msgstr "ए फाइल ल सहेज नइ सके. किरपा करके, जांचव कि का आप मन ल लिखे के अनुमति हे."

#: katemailfiles.cpp:113
#, kde-format
msgid ""
"<p>The current file:<br /><strong>%1</strong><br />has been modified. "
"Modifications will not be available in the attachment.</p><p>Do you want to "
"save it before sending it?</p>"
msgstr ""
"<p>अभी हाल के फाइल:<br /><strong>%1</strong><br />सुधार दे गे हे. संलग्नक मं ये "
"परिवर्धन नइ मिलत रहेंगे.</p><p>भेजने से पहिली का आप मन एला सहेजना चाहू?</p>"

#: katemailfiles.cpp:116
msgid "Save Before Sending?"
msgstr "भेजने से पहिली सहेजव?"

#: katemailfiles.cpp:116
msgid "Do Not Save"
msgstr "सहेजव नइ"

#: katemailfilesdialog.cpp:54
msgid "Email Files"
msgstr "फाइल मन ल ई-मेल करव"

#: katemailfilesdialog.cpp:56 katemailfilesdialog.cpp:116
msgid "&Show All Documents >>"
msgstr "सब्बो कागद देखाव (&S) >>"

#: katemailfilesdialog.cpp:60
msgid "&Mail..."
msgstr "डाक (&M)"

#: katemailfilesdialog.cpp:67
msgid ""
"<p>Press <strong>Mail...</strong> to email the current document.</p><p>To "
"select more documents to send, press <strong>Show All Documents&nbsp;&gt;&gt;"
"</strong>.</p>"
msgstr ""
"<p>दबाव <strong>डाक...</strong> अभी हाल के कागद ल ई-मेल करे बर.</p><p>अधिक कागद "
"चुनकर भेजे बर दबाव<strong>सब्बो कागद देखाव&nbsp;&gt;&gt;</strong>.</p>"

#: katemailfilesdialog.cpp:72
msgid "Name"
msgstr "नाम"

#: katemailfilesdialog.cpp:73
msgid "URL"
msgstr "यूआरएल"

#: katemailfilesdialog.cpp:124
msgid "&Hide Document List <<"
msgstr "कागद सूची लुकाव (&H) <<"

#: katemailfilesdialog.cpp:125
msgid "Press <strong>Mail...</strong> to send selected documents"
msgstr "दबाव <strong>डाक...</strong> चुने कागद भेजे बर"

