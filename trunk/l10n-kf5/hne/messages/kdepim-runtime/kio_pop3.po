#, kde-format
msgid "The server terminated the connection."
msgstr "सर्वर हर कनेक्सन तोड़ा."

#: pop3.cpp:257
#, kde-format
msgid ""
"Invalid response from server:\n"
"\"%1\""
msgstr ""
