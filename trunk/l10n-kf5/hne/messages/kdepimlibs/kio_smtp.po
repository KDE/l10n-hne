#: command.cpp:149
msgid ""
"The server rejected both EHLO and HELO commands as unknown or "
"unimplemented.\n"
"Please contact the server's system administrator."
msgstr ""
"सर्वर हर दुनों ही EHLO अउ HELO कमांड ल अग्यात या लागू नइ मान कर अस्वीकृत कर दिस.\n"
"किरपा करके, सर्वर के तंत्र प्रसासक से संपर्क करव."

#: command.cpp:163
#, kde-format
msgid ""
"Unexpected server response to %1 command.\n"
"%2"
msgstr ""
"कमांड %1 मं अप्रत्यासित सर्वर रेस्पांस:\n"
"%2"

#: command.cpp:187
msgid ""
"Your SMTP server does not support TLS. Disable TLS, if you want to connect "
"without encryption."
msgstr ""
"आप मन के एसएमटीपी सर्वर टीएलएस समर्थन नइ करथे . टीएलएस अक्छम करव यदि आप मन बिना "
"एनक्रिप्सन के कनेक्ट होना चाहथो ."

#: command.cpp:198
#, fuzzy
#| msgid ""
#| "Your SMTP server claims to support TLS, but negotiation was "
#| "unsuccessful.\n"
#| "You can disable TLS in KDE using the crypto settings module."
msgid ""
"Your SMTP server claims to support TLS, but negotiation was unsuccessful.\n"
"You can disable TLS in the SMTP account settings dialog."
msgstr ""
"आप मन के एसएमटीपी सर्वर टीएलएस के समर्थन के दावा करथे  फेर बातचीत फेल रहिस. \n"
"आप केडीई मं टीएलएस ल क्रिप्टो सेटिंग माड्यूल के उपयोग से अक्छम कर सकथो ."

#: command.cpp:202
msgid "Connection Failed"
msgstr "कनेक्सन फेल"

#: command.cpp:208
#, kde-format
msgid "An error occurred during authentication: %1"
msgstr "प्रमानीकरन के समय एक गलती होइस:%1"

#: command.cpp:279
msgid "No authentication details supplied."
msgstr "कोई प्रमानीकरन विवरन नइ मिले"

#: command.cpp:387
msgid "Choose a different authentication method."
msgstr "भिन्न प्रमानीकरन विधि चुनव."

#: command.cpp:389
#, kde-format
msgid "Your SMTP server does not support %1."
msgstr "आप मन के एसएमटीपी सर्वर %1 समर्थित नइ करथे."

#: command.cpp:390
msgid "Your SMTP server does not support (unspecified method)."
msgstr "आप मन के एसएमटीपी सर्वर समर्थित नइ करथे (अनिर्धारित विधि)"

#: command.cpp:394
#, kde-format
msgid ""
"Your SMTP server does not support authentication.\n"
"%1"
msgstr ""
"आप मन के एसएमटीपी सर्वर प्रमानीकरन समर्थित नइ करथे .\n"
"%1"

#: command.cpp:399
#, kde-format
msgid ""
"Authentication failed.\n"
"Most likely the password is wrong.\n"
"%1"
msgstr ""
"लागिन मं फेल. \n"
"हो सकथे पासवर्ड गलत हे.\n"
"%1"

#: command.cpp:556
msgid "Could not read data from application."
msgstr "अनुपरयोग से डाटा नइ पढ़े जा सकिस."

#: command.cpp:574
#, kde-format
msgid ""
"The message content was not accepted.\n"
"%1"
msgstr ""
"संदेस सामान स्वीकार नइ होइस.\n"
"%1"

#: response.cpp:112
#, kde-format
msgid ""
"The server responded:\n"
"%1"
msgstr ""
"सर्वर हर जवाब दिस:\n"
"%1"

#: response.cpp:114
#, kde-format
msgid "The server responded: \"%1\""
msgstr "सर्वर हर जवाब दिस: \"%1\""

#: response.cpp:117
msgid "This is a temporary failure. You may try again later."
msgstr "वहाँ एक अस्थायी फेल होइस. आप मन बाद मं फिर से  कोसिस कर सकथो ."

#: smtp.cpp:147
msgid "The application sent an invalid request."
msgstr "अनुपरयोग हर अवैध निवेदन प्रेसित करिस."

#: smtp.cpp:207
msgid "The sender address is missing."
msgstr "भेजइया के पता गंवा गे हे."

#: smtp.cpp:214
#, kde-format
msgid "SMTPProtocol::smtp_open failed (%1)"
msgstr "एसएमटीपी-प्रोटोकाल::smtp_open फेल (%1)"

#: smtp.cpp:222
#, fuzzy, kde-format
#| msgid ""
#| "Your server does not support sending of 8-bit messages.\n"
#| "Please use base64 or quoted-printable encoding."
msgid ""
"Your server (%1) does not support sending of 8-bit messages.\n"
"Please use base64 or quoted-printable encoding."
msgstr ""
"आप मन के सर्वर 8-बिट संदेस प्रेसित करना समर्थित नइ करथे .\n"
"किरपा करके, बेस64 या कोटेड-प्रिंटेबल एनकोडिंग उपयोग करव."

#: smtp.cpp:272
msgid "Writing to socket failed."
msgstr "सोकेट पे लिखे मं फेल."

#: smtp.cpp:312
#, kde-format
msgid "Invalid SMTP response (%1) received."
msgstr "अवैध एसएमटीपी जवाब (%1) मिलिस."

#: smtp.cpp:541
#, fuzzy, kde-format
#| msgid ""
#| "The server did not accept the connection.\n"
#| "%1"
msgid ""
"The server (%1) did not accept the connection.\n"
"%2"
msgstr ""
"सर्वर हर कनेक्सन स्वीकार नइ करिस.\n"
"%1"

#: smtp.cpp:607
msgid "Username and password for your SMTP account:"
msgstr "आप मन के एसएमटीपी खाता के कमइया नाम अउ पासवर्ड:"

#: transactionstate.cpp:51
#, kde-format
msgid ""
"The server did not accept a blank sender address.\n"
"%1"
msgstr ""
"सर्वर भेजे वाले के खाली पता ल स्वीकार नइ करथे .\n"
"%1"

#: transactionstate.cpp:54
#, kde-format
msgid ""
"The server did not accept the sender address \"%1\".\n"
"%2"
msgstr ""
"सर्वर से भेजे वाले के पता \"%1\" ल स्वीकार नइ कर रहा.\n"
"%2"

#: transactionstate.cpp:112
#, kde-format
msgid ""
"Message sending failed since the following recipients were rejected by the "
"server:\n"
"%1"
msgstr ""
"संदेस भेजे जाना फेल काबर कि नीचे वाले पावइया सर्वर से अस्वीकृत कर दे गे:\n"
"%1"

#: transactionstate.cpp:117
#, kde-format
msgid ""
"The attempt to start sending the message content failed.\n"
"%1"
msgstr ""
"संदेस सामान ल प्रेसित करे के कोसिस फेल.\n"
"%1"

#: transactionstate.cpp:122
msgid "Unhandled error condition. Please send a bug report."
msgstr "अनहेंडल्ड गलती हालत. किरपा करके, बग रपट भेजव."
