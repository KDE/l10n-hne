#: ktrash.cpp:33
msgid "ktrash"
msgstr "के-ट्रैस (घुरुवा)"

#: ktrash.cpp:35
#, fuzzy
msgid ""
"Helper program to handle the KDE trash can\n"
"Note: to move files to the trash, do not use ktrash, but \"kioclient move "
"'url' trash:/\""
msgstr ""
"केडीई घुरुवा ल हेंडल करे के हेल्पर प्रोग्राम\n"
"टीप: फाइल मन ल घुरुवा मं ले जाय बर केट्रैस के परयोग नइ करव बल्कि ए करव - \"kfmclient "
"move 'url' trash:/\""

#: ktrash.cpp:39
msgid "Empty the contents of the trash"
msgstr "घुरुवा खाली करव"

#: ktrash.cpp:41
msgid "Restore a trashed file to its original location"
msgstr "घुरुवा फाइल ल ओखर पूर्व जगह मं पुनर्स्थापित करव"

#: ktrash.cpp:43
msgid "Ignored"
msgstr "अनदेखा करिस"

#: trashimpl.cpp:1128
msgid ""
