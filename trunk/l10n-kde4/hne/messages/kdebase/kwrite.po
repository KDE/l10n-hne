#: kwritemain.cpp:72 kwritemain.cpp:487
msgid ""
"A KDE text-editor component could not be found;\n"
"please check your KDE installation."
msgstr ""
"केडीई पाठ संपादक अवयव नइ मिलिस;\n"
"किरपा करके, अपन केडीई इंस्टालेसन जांचव."

#: kwritemain.cpp:153
msgid "Use this to close the current document"
msgstr "अभी हाल के कागद ल बन्द करे बर एखर उपयोग करव"

#: kwritemain.cpp:157
msgid "Use this command to create a new document"
msgstr "नवा कागद खोले बर ए कमांड ल उपयोग करव"

#: kwritemain.cpp:159
msgid "Use this command to open an existing document for editing"
msgstr "अभी हाल के कागद ल संपादन बर खोले बर ए कमांड उपयोग करव"

#: kwritemain.cpp:163
msgid ""
"This lists files which you have opened recently, and allows you to easily "
"open them again."
msgstr ""
"आप मन जऊन फाइल मन ल खोले हव ओखर सूची ए हर बताथे, अउ आप मन ल ए मन ल आसानी से फिर "
"से खोलन देथे "

#: kwritemain.cpp:167
msgid "&New Window"
msgstr "नवा विंडो (&N)"

#: kwritemain.cpp:169
msgid "Create another view containing the current document"
msgstr "अभी हाल के कागद के संग नवा दृस्य बनाव"

#: kwritemain.cpp:172
msgid "Close the current document view"
msgstr "अभी हाल के कागद दृस्य बंद करव"

#: kwritemain.cpp:179
msgid "Use this command to show or hide the view's statusbar"
msgstr "ये कमांड के उपयोग दृस्य के स्थिति पट्टी ल देखाय या लुकाय बर करव"

#: kwritemain.cpp:181
msgid "Sho&w Path"
msgstr "पथ देखाव (&w)"

#: kwritemain.cpp:184
msgid "Show the complete document path in the window caption"
msgstr "विंडो सीर्सक मं कागद के पूरा रस्ता देखाव"

#: kwritemain.cpp:187
msgid "Configure the application's keyboard shortcut assignments."
msgstr "अनुपरयोग के कुंजीपट सार्टकट एसाइनमेंट कान्फिगर करव"

#: kwritemain.cpp:191
msgid "Configure which items should appear in the toolbar(s)."
msgstr "कान्फिगर करव कि कोन से चीज औजार पट्टी मन मं प्रकट होही"

#: kwritemain.cpp:194
msgid "&About Editor Component"
msgstr "संपादक अवयव परिचय (&A)"

#: kwritemain.cpp:211
msgid " INS "
msgstr " प्रविस्ट "

