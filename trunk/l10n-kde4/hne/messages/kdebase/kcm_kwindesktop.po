#: desktop.cpp:66
msgid ""
"<h1>Multiple Desktops</h1>In this module, you can configure how many virtual "
"desktops you want and how these should be labeled."
msgstr ""
"<h1>बहुत अकन डेस्कटाप</h1>ये माड्यूल मं आप मन कान्फिगर कर सकथो कि आप मन कतका आभासी "
"डेस्कटाप चाहथो अउ ओमां कऊन किसम के लेबल लगाए जाय."

#: desktop.cpp:76
msgid "N&umber of desktops: "
msgstr "डेस्कटाप के संख्याः (&u)"

#: desktop.cpp:82
msgid ""
"Here you can set how many virtual desktops you want on your KDE desktop. "
"Move the slider to change the value."
msgstr ""
"इहां आप मन सेट कर सकथो कि आप मन अपन केडीई डेस्कटाप मं कतका आभासी डेस्कटाप चाहथो. मूल्य "
"बदले बर स्लाइडर ल खिसकाव."

#: desktop.cpp:92
msgid "Desktop &Names"
msgstr "डेस्कटाप नाम (&N)"

#: desktop.cpp:97
#, kde-format
msgid "Desktop %1:"
msgstr "डेस्कटाप %1:"

#: desktop.cpp:100 desktop.cpp:101
#, kde-format
msgid "Here you can enter the name for desktop %1"
msgstr "इहां आप मन डेस्कटाप %1 बर नाम भर सकथो "

#: desktop.cpp:115
msgid "Mouse wheel over desktop background switches desktop"
msgstr "डेस्कटाप के ऊपर मुसुवा चकरी चलाय से डेस्कटाप बदलही"

#: desktop.cpp:242 desktop.cpp:266
#, kde-format
msgid "Desktop %1"
msgstr "डेस्कटाप %1"
