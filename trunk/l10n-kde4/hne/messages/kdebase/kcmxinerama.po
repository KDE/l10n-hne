#: kcmxinerama.cpp:55
msgid "kcmxinerama"
msgstr "केसीएमसिनेरामा"

#: kcmxinerama.cpp:56
msgid "KDE Multiple Monitor Configurator"
msgstr "केडीई बहुत अकन मानीटर कान्फिगरेटर"

#: kcmxinerama.cpp:58
msgid "(c) 2002-2003 George Staikos"
msgstr "(c) 2002-2003 जार्ज स्टाइकास"

#: kcmxinerama.cpp:60
msgid "George Staikos"
msgstr "जार्ज स्टायकास"

#: kcmxinerama.cpp:63
msgid ""
"<h1>Multiple Monitors</h1> This module allows you to configure KDE support "
"for multiple monitors."
msgstr ""
"<h1>बहुत अकन मानीटर</h1> ए माड्यूल आप मन ल बहुत अकन मानीटरों बर केडीई समर्थन ल "
"कान्फिगर करन देथे ."

#: kcmxinerama.cpp:87
#, kde-format
msgid "Display %1"
msgstr "प्रदर्सक %1"

#: kcmxinerama.cpp:105
msgid "Display Containing the Pointer"
msgstr "सूचक सहित प्रदर्सक"

#: kcmxinerama.cpp:116
msgid ""
"<qt><p>This module is only for configuring systems with a single desktop "
"spread across multiple monitors. You do not appear to have this "
"configuration.</p></qt>"
msgstr ""
"<qt><p>ये माड्यूल बहुत अकन मानिटर मं फैले एक डेस्कटाप के तंत्र ल कान्फिगर करे बर हे. आप मन "
"के कान्फिगरेसन मं ए नइ मिलत हे.</p></qt>"

#: kcmxinerama.cpp:180
msgid "Some settings may affect only newly started applications."
msgstr "कुछ सेटिंग नवा चालू करे अनुपरयोग मन मं ही लागू होही."

#: kcmxinerama.cpp:180
msgid "KDE Multiple Monitors"
msgstr "केडीई बहुत अकन मानीटर"

