#: fileprops.cpp:230
msgid "kfile"
msgstr "के-फाइल"

#: fileprops.cpp:231
msgid "A command-line tool to read and modify metadata of files."
msgstr "फाइल मन के मेटाडाटा पढ़े अउ सुधारे बर एक कमांड लाइन औजार."

#: fileprops.cpp:232
msgid "(c) 2002, Carsten Pfeiffer"
msgstr "कापीराइट (c) 2002,  कार्स्टेन फेइफर"

#: fileprops.cpp:236
msgid "Carsten Pfeiffer"
msgstr "कार्स्टेन फेइफर"

#: fileprops.cpp:245
msgid "Do not print the mimetype of the given file(s)"
msgstr "दे गे फाइल मन के माइम किसिम ल नइ छापव"

#: fileprops.cpp:247
msgid "List all supported metadata keys."
msgstr "सब्बो समर्थित मेटाडाटा कुंजी के सूची देव"

#: fileprops.cpp:249
msgid "List all metadata keys which have a value in the given file(s)."
msgstr "सब्बो मेटाडाटा कुंजी सूची देव जऊन मं दे गे फाइल के मान हे."

#: fileprops.cpp:252
msgid ""
"Do not print a warning when more than one file was given and they do not all "
"have the same mimetype."
msgstr ""
"चेतावनी नइ छापव यदि एक से अधिक फाइल दे गे हे अउ ओ सब्बो मं समान माइम किसिम नइ होही."

#: fileprops.cpp:255
msgid "Prints all metadata values, available in the given file(s)."
msgstr "सब्बो मेटाडाटा मान छापव, जऊन दे गे फाइल मं मिलत हे."

#: fileprops.cpp:257
msgid ""
"Opens a KDE properties dialog to allow viewing and modifying of metadata of "
"the given file(s)"
msgstr "दे गे फाइल मन के मेटाडाटा देखे अउ सुधारे बर केडीई गुन गोठ खोलथे."

#: fileprops.cpp:259
msgid ""
"Prints the value for 'key' of the given file(s). 'key' may also be a comma-"
"separated list of keys"
msgstr ""

#: fileprops.cpp:261
msgid ""
"Attempts to set the value 'value' for the metadata key 'key' for the given "
"file(s)"
msgstr ""

#: fileprops.cpp:263
msgid "The file (or a number of files) to operate on."
msgstr "फाइल (या कई फाइल मन ल) जऊन मं आपरेट करे जाही."

#: fileprops.cpp:277
msgid "No files specified"
msgstr "कोई फाइल निरधारित नइ हे."

#: fileprops.cpp:297
msgid "Cannot determine metadata"
msgstr "मेटाडाटा निरधारित नइ कर सकिस"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "रविसंकर सिरीवास्तव, जी. करूनाकर"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "raviratlami@aol.in"
