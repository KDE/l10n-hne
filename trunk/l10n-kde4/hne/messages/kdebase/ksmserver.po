#: main.cpp:52
msgid ""
"The reliable KDE session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"विस्वसनीय सत्र प्रबंधक जऊन मानक X11R6 से बातचीत करथे  \n"
"सत्र प्रबंधक प्रोटोकाल (XSMP)."

#: main.cpp:244
msgid "The KDE Session Manager"
msgstr "केडीई सत्र प्रबंधक"

#: main.cpp:246
msgid "(C) 2000, The KDE Developers"
msgstr "(c) 2000, केडीई बनइया मन"

#: main.cpp:247
msgid "Matthias Ettrich"
msgstr "मेथियास एट्रिच"

#: main.cpp:248
msgid "Luboš Luňák"
msgstr "लुबोस लुनाक"

#: main.cpp:248
msgid "Maintainer"
msgstr "मेंटेनर"

#: main.cpp:256
msgid "Restores the saved user session if available"
msgstr "यदि मिलत होही तब सहेजे गे कमइया सत्र ल बहाल करव"

#: main.cpp:258
msgid ""
"Starts 'wm' in case no other window manager is \n"
"participating in the session. Default is 'kwin'"
msgstr ""
"सुरू करथे  'डबल्यूएम' यदि सत्र में कोनो अउ विंडो प्रबंधक नइ मिलथे.\n"
"डिफाल्ट हे 'केविन'"

#: main.cpp:259
msgid "Also allow remote connections"
msgstr "रिमोट कनेक्सन स्वीकारव"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "रविसंकर सिरीवास्तव"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "raviratlami@gmail.com"

#: shutdown.cpp:365
#, kde-format
msgid "Logout canceled by '%1'"
msgstr "लागआउट '%1' से खारिज होगे"

#: shutdowndlg.cpp:386
msgid "&Logout"
msgstr "लागआउट (&L)"

#: shutdowndlg.cpp:395
msgid "&Turn Off Computer"
msgstr "कम्प्यूटर बन्द करव (&T)"

#: shutdowndlg.cpp:408
msgid "&Standby"
msgstr "स्टैंडबाय (&S)"

#: shutdowndlg.cpp:412
msgid "Suspend to &RAM"
msgstr "रैम मं सस्पेंड करव (&R)"

#: shutdowndlg.cpp:416
msgid "Suspend to &Disk"
msgstr "डिस्क मं सस्पेंड करव (&D)"

#: shutdowndlg.cpp:422
msgid "&Restart Computer"
msgstr "कम्प्यूटर फिर से चालू करव (&R)"

#: shutdowndlg.cpp:446
msgctxt "default option in boot loader"
msgid " (default)"
msgstr ""

#: shutdowndlg.cpp:466
msgid "&Cancel"
msgstr "खारिज करव (&C)"

#: shutdowndlg.cpp:524
#, kde-format
msgid "Logging out in 1 second."
msgid_plural "Logging out in %1 seconds."
msgstr[0] "१ सेकन्ड मं लागआउट."
msgstr[1] "%1 सेकन्ड मं लागआउट."

#: shutdowndlg.cpp:527
#, kde-format
msgid "Turning off computer in 1 second."
msgid_plural "Turning off computer in %1 seconds."
msgstr[0] "कम्प्यूटर १ सेकन्ड मं बन्द."
msgstr[1] "कम्प्यूटर %1 सेकन्ड मं बन्द."

#: shutdowndlg.cpp:530
#, kde-format
msgid "Restarting computer in 1 second."
msgid_plural "Restarting computer in %1 seconds."
msgstr[0] "कम्प्यूटर 1 सेकन्ड मं रीबूट."
msgstr[1] "कम्प्यूटर %1 सेकन्ड मं रीबूट."

