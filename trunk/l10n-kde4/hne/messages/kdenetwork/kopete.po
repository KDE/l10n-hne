#: libkopete/kopetecommandhandler.cpp:131
msgid ""
"USAGE: /help [<command>] - Used to list available commands, or show help for "
"a specified command."
msgstr ""
"उपयोग: /help [<command>] - मिलत कमांड के सूची दे के उपयोग मं आथे, या निरधारित कमांड "
"बर मदद देखाथे."

#: libkopete/kopetecommandhandler.cpp:134
msgid "USAGE: /close - Closes the current view."
msgstr "उपयोग: /close - अभी हाल के विंडो ल बन्द करथे."

#: libkopete/kopetecommandhandler.cpp:138
msgid "USAGE: /part - Closes the current view."
msgstr "उपयोग: /part - अभी हाल के दृस्य ल बन्द करथे."

#: libkopete/kopetecommandhandler.cpp:141
msgid "USAGE: /clear - Clears the active view's chat buffer."
msgstr "उपयोग: /clear- सक्रिय दृस्य के गपसप बफर ल साफ करथे."

#: libkopete/kopetecommandhandler.cpp:147
msgid ""
"USAGE: /away [<reason>] - Marks you as away/back for the current account "
"only."
msgstr ""
"उपयोग: /away [<reason>] - आप मन ल सिरिफ अभी हाल के खाता बर दूर/वापस चिनहित करथे."

#: libkopete/kopetecommandhandler.cpp:150
msgid "USAGE: /awayall [<reason>] - Marks you as away/back for all accounts."
msgstr "उपयोग: /awayall [<reason>] - आप मन ल सब्बो खाता बर दूर/वापस चिनहित करथे."

#: libkopete/kopetecommandhandler.cpp:153
msgid ""
"USAGE: /say <text> - Say text in this chat. This is the same as just typing "
"a message, but is very useful for scripts."
msgstr ""
"उपयोग: /say <text> - ए गपसप मं पाठ से बोलव. ए वइसनेच हे जइसन कि संदेस टाइप कर रहे "
"हव फेर स्क्रिप्ट्स बर बहुत उपयोगी हे."

#: libkopete/kopetecommandhandler.cpp:157
msgid ""
"USAGE: /exec [-o] <command> - Executes the specified command and displays "
"the output in the chat buffer. If -o is specified, the output is sent to all "
"members of the chat."
msgstr ""

