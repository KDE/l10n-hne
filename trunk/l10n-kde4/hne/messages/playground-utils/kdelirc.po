#: iraction.cpp:122
msgid "Exit mode"
msgstr "एक्जिट मोड"

#: iraction.cpp:124
#, kde-format
msgid "Switch to %1"
msgstr "%1 मं स्विच करव"

#: iraction.cpp:127
msgid "Just start"
msgstr "सिरिफ चालू करव"

#: iraction.cpp:141
msgid "Do actions before. "
msgstr "काम पहिली करव"

#: iraction.cpp:142
msgid "Do actions after. "
msgstr "काम बाद मं करव"

#: iraction.cpp:146
msgid "Auto-start. "
msgstr "अपने अपन-सुरू"

#: iraction.cpp:147
msgid "Repeatable. "
msgstr "बारंबार जा सके"

#: iraction.cpp:148
msgid "Do nothing if many instances. "
msgstr "यदि बहुत से इंस्टैंसेस होही तहां कुछ नइ करव."

#: iraction.cpp:149
msgid "Send to top instance. "
msgstr "सीर्स इंस्टैंस मं भेजव."

#: iraction.cpp:150
msgid "Send to bottom instance. "
msgstr "तल इंस्टैंस मं भेजव."

#: iraction.cpp:150
msgid "Send to all instances. "
msgstr "सब्बो इंस्टैंसेस ल भेजव."
