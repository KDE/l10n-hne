#: cervisiapart.cpp:199
msgid "Remote CVS working folders are not supported."
msgstr "रिमोट सीवीएस काम वाले फोल्डर समर्थित नइ हे."

#: cervisiapart.cpp:208
msgid ""
"You cannot change to a different folder while there is a running cvs job."
msgstr "जब कोनो सीवीएस काम चलत होही तहां आप मन कोनो अउ फोल्डर मं बदल नइ सकहू."

#: cervisiapart.cpp:229
msgid ""
"F - All files are hidden, the tree shows only folders\n"
"N - All up-to-date files are hidden\n"
"R - All removed files are hidden"
msgstr ""
"F - सब्बो फाइल मन ल लुकाए हे, साखाओं मं सिरिफ फोल्डर ही दिखाई देही\n"
"N - सब्बो अपडेट फाइल मन ल लुकाए हे\n"
"R - सब्बो मिटाय गे फाइल मन ल लुकाए हे"

#: cervisiapart.cpp:242
msgid "O&pen Sandbox..."
msgstr "सेंडबाक्स खोलव... (&p)"

#: cervisiapart.cpp:246
msgid "Opens a CVS working folder in the main window"
msgstr "मुख्य विंडो मं एक सीवीएस काम वाले फोल्डर खोलथे "

#: cervisiapart.cpp:250
msgid "Recent Sandboxes"
msgstr "हाल केसेंडबाक्सेस"

#: cervisiapart.cpp:254
msgid "&Insert ChangeLog Entry..."
msgstr "चेंज लाग प्रविस्टि भरव... (&I)"

#: cervisiapart.cpp:257
msgid "Inserts a new intro into the file ChangeLog in the toplevel folder"
msgstr "सीर्स स्तर के फोल्डर मं फाइल चेंजलाग मं नवा इंट्रो भरव करथे "

#: cervisiapart.cpp:261
msgid "&Update"
msgstr "अपडेट (&U)"

#: cervisiapart.cpp:265
msgid "Updates (cvs update) the selected files and folders"
msgstr "चुने गे फाइल मन ल अउ फोल्डर ल अपडेट (cvs update) करथे "

#: cervisiapart.cpp:269
msgid "&Status"
msgstr "स्थिति (&S)"

#: cervisiapart.cpp:273
msgid "Updates the status (cvs -n update) of the selected files and folders"
msgstr "चुने गे फाइल मन ल अउ फोल्डर के स्थिति ल अपडेट (cvs -n update) करथे "

#: cervisiapart.cpp:277 resolvedialog.cpp:172
msgid "&Edit"
msgstr "संपादन (&E)"

#: cervisiapart.cpp:280
msgid "Opens the marked file for editing"
msgstr "चिनहित फाइल ल संपादन बर खोलथे "

#: cervisiapart.cpp:284
msgid "Reso&lve..."
msgstr "निराकरन... (&l)"

#: cervisiapart.cpp:287
msgid "Opens the resolve dialog with the selected file"
msgstr "चुने गे फाइल के साथ निराकरन गोठ खोलथे "

#: cervisiapart.cpp:291
msgid "&Commit..."
msgstr "कमिट... (&C)"

#: cervisiapart.cpp:295
msgid "Commits the selected files"
msgstr "चुने गे फाइल मन ल कमिट करव"

#: cervisiapart.cpp:299
msgid "&Add to Repository..."
msgstr "रेपासिटरी मं जोड़व... (&A)"

#: cervisiapart.cpp:302
msgid "Add"
msgstr "जोड़व"

#: cervisiapart.cpp:304
msgid "Adds (cvs add) the selected files to the repository"
msgstr "चुने गे फाइल मन ल भंडार मं (cvs add) जोड़थे "

#: cervisiapart.cpp:308
msgid "Add &Binary..."
msgstr "द्विचर जोडें... (&B)"

#: cervisiapart.cpp:311
msgid "Adds (cvs -kb add) the selected files as binaries to the repository"
msgstr "चुने गे फाइल मन ल द्विचर रूप मं भंडार मं (cvs -kb add) जोड़थे "

#: cervisiapart.cpp:315
msgid "&Remove From Repository..."
msgstr "भन्डार से मेटाव... (&R)"

#: cervisiapart.cpp:318
msgid "Remove"
msgstr "हटाव"

#: cervisiapart.cpp:320
msgid "Removes (cvs remove) the selected files from the repository"
msgstr "(सीवीएस रीमूव) चुने गे फाइल मन ल भन्डार से मिटाथे "

#: cervisiapart.cpp:324
msgid "Rever&t"
msgstr "पीछू करव (&t)"

#: cervisiapart.cpp:327
msgid "Reverts (cvs update -C) the selected files (only cvs 1.11)"
msgstr "चुने गे फाइल मन ल (सिरिफ सीवीएस 1.11) रिवर्ट (cvs update -C) करथे "

#: cervisiapart.cpp:331
msgid "&Properties"
msgstr "गुन (&P)"

#: cervisiapart.cpp:338
msgid "Stop"
msgstr "रुकव"

#: cervisiapart.cpp:343
msgid "Stops any running sub-processes"
msgstr "कोई चलती उप-काम मन ल रोकथे "

#: cervisiapart.cpp:348
msgid "Browse &Log..."
msgstr "लाग ब्राउज करव... (&L)"

#: cervisiapart.cpp:352
msgid "Shows the revision tree of the selected file"
msgstr "चुने गे फाइल मन के संसोधन ट्री देखाथे "

#: cervisiapart.cpp:357
msgid "Browse Multi-File Log..."
msgstr "बहु-फाइल लाग ब्राउज करव..."

#: cervisiapart.cpp:361
msgid "&Annotate..."
msgstr "एन्नोटेट... (&A)"

#: cervisiapart.cpp:365
msgid "Shows a blame-annotated view of the selected file"
msgstr "चुने गे फाइल मन के ब्लेम-एन्नोटेटेड दृस्य देखाथे "

#: cervisiapart.cpp:369
msgid "&Difference to Repository (BASE)..."
msgstr "भंडार (बेस) मं भिन्नता... (&D)"

#: cervisiapart.cpp:373
msgid ""
"Shows the differences of the selected file to the checked out version (tag "
"BASE)"
msgstr "चुने गे फाइल अउ चेक्ड आउट संस्करन के बीच के भिन्नता देखाथे  (टैग BASE)"

#: cervisiapart.cpp:377
msgid "Difference to Repository (HEAD)..."
msgstr "भंडार (सीर्स) मं भिन्नता..."

#: cervisiapart.cpp:381
msgid ""
"Shows the differences of the selected file to the newest version in the "
"repository (tag HEAD)"
msgstr "रेपासिटरी (टैग हेड) मं चुने गे फाइल अउ नवीन संस्करन के बीच भिन्नता देखाथे "

#: cervisiapart.cpp:385
msgid "Last &Change..."
msgstr "आखरी बदलाव... (&C)"

#: cervisiapart.cpp:388
msgid ""
"Shows the differences between the last two revisions of the selected file"
msgstr "चुने गे फाइल के आखरी दो रिवीजनों के बीच के भिन्नता देखाथे "

#: cervisiapart.cpp:392
msgid "&History..."
msgstr "इतिहास....(&H)"

#: cervisiapart.cpp:395
msgid "Shows the CVS history as reported by the server"
msgstr "सर्वर से रिपोट करे सीवीएस इतिहास ल देखाथे "

#: cervisiapart.cpp:399
msgid "&Unfold File Tree"
msgstr "फाइल ट्री अनफोल्ड करव (&U)"

#: cervisiapart.cpp:403
msgid "Opens all branches of the file tree"
msgstr "फाइल ट्री के सब्बो साखाओं ल खोलथे "

#: cervisiapart.cpp:407
msgid "&Fold File Tree"
msgstr "फाइल ट्री फोल्ड करव (&F)"

#: cervisiapart.cpp:410
msgid "Closes all branches of the file tree"
msgstr "फाइल ट्री के सब्बो साखाओं ल बन्द करथे "

#: cervisiapart.cpp:417
msgid "&Tag/Branch..."
msgstr "टैग/साखा... (&T)"

#: cervisiapart.cpp:420
msgid "Creates a tag or branch for the selected files"
msgstr "चुने गे फाइल मन के टैग या साखा बनाथे "

#: cervisiapart.cpp:424
msgid "&Delete Tag..."
msgstr "टैग मेटाव... (&D)"

#: cervisiapart.cpp:427
msgid "Deletes a tag from the selected files"
msgstr "चुने गे फाइल मन ल टैग मिटाथे "

#: cervisiapart.cpp:431
msgid "&Update to Tag/Date..."
msgstr "टैग/तारीक मं अपडेट करव... (&U)"

#: cervisiapart.cpp:434
msgid "Updates the selected files to a given tag, branch or date"
msgstr "चुने गे फाइल ल दे गे टैग, साखा या तारीक से अपडेट करथे "

#: cervisiapart.cpp:438
msgid "Update to &HEAD"
msgstr "सीर्स मं अपडेट करव (&H)"

#: cervisiapart.cpp:441
msgid "Updates the selected files to the HEAD revision"
msgstr "चुने गे फाइल मन के सीर्स संसोधन अपडेट करथे "

#: cervisiapart.cpp:445
msgid "&Merge..."
msgstr "मिलाव... (&M)"

#: cervisiapart.cpp:448
msgid "Merges a branch or a set of modifications into the selected files"
msgstr "साखा या परिवर्धनों के सेट ल चुने गे फाइल मन सामिल करथे "

#: cervisiapart.cpp:452
msgid "&Add Watch..."
msgstr "पहरा जोड़व... (&A)"

#: cervisiapart.cpp:455
msgid "Adds a watch for the selected files"
msgstr "चुने गे फाइल मन बर पहरा जोड़व"

#: cervisiapart.cpp:459
msgid "&Remove Watch..."
msgstr "पहरा मेटाव... (&R)"

#: cervisiapart.cpp:462
msgid "Removes a watch from the selected files"
msgstr "चुने गे फाइल मन ल पहरा मेटाव"

#: cervisiapart.cpp:466
msgid "Show &Watchers"
msgstr "पहरेदार देखाव (&W)"

#: cervisiapart.cpp:469
msgid "Shows the watchers of the selected files"
msgstr "चुने गे फाइल मन बर पहरेदार देखाव"

#: cervisiapart.cpp:473
msgid "Ed&it Files"
msgstr "फाइल मन के संपादन करव (&i)"

#: cervisiapart.cpp:476
msgid "Edits (cvs edit) the selected files"
msgstr "(सीवीएस संपादन) चुने गे फाइल मन ल संपादित करथे "

#: cervisiapart.cpp:480
msgid "U&nedit Files"
msgstr "फाइल मन ल अका संपादन करव (&n)"

#: cervisiapart.cpp:483
msgid "Unedits (cvs unedit) the selected files"
msgstr "(सीवीएस असंपादन) चुने गे फाइल मन ल असंपादित करथे "

#: cervisiapart.cpp:487
msgid "Show &Editors"
msgstr "संपादक देखाव (&E)"

#: cervisiapart.cpp:490
msgid "Shows the editors of the selected files"
msgstr "चुने गे फाइल मन के संपादक देखाथे "

#: cervisiapart.cpp:494
msgid "&Lock Files"
msgstr "फाइल मन ल तालाबंद करव (&L)"

#: cervisiapart.cpp:497
msgid "Locks the selected files, so that others cannot modify them"
msgstr "चुने गे फाइल मन ल तालाबंद करथे , जेखर से अउ ओ मन ल परिवर्धित नइ कर सकें"

#: cervisiapart.cpp:501
msgid "Unl&ock Files"
msgstr "फाइल मन से तालाबंदी हटाव (&o)"

#: cervisiapart.cpp:504
msgid "Unlocks the selected files"
msgstr "चुने गे फाइल मन के तालाबंदी हटाव"

#: cervisiapart.cpp:508
msgid "Create &Patch Against Repository..."
msgstr "रेपोसिटरी के विरूद्ध पैच तैयार करव... (&P)"

#: cervisiapart.cpp:511
msgid "Creates a patch from the modifications in your sandbox"
msgstr "आप मन के सेंडबक्से मं परिवर्धनों के पैच बनाथे "

#: cervisiapart.cpp:518
msgid "&Create..."
msgstr "बनाव... (&C)"

#: cervisiapart.cpp:522
msgid "&Checkout..."
msgstr "चेकआउट... (&C)"

#: cervisiapart.cpp:525
msgid "Allows you to checkout a module from a repository"
msgstr "रेपासिटरी से माड्यूल चैकआउट करन देथे "

#: cervisiapart.cpp:529
msgid "&Import..."
msgstr "आयात... (&I)"

#: cervisiapart.cpp:532
msgid "Allows you to import a module into a repository"
msgstr "रेपासिटरी मं आप मन ल माड्यूल आयात करन देथे "

#: cervisiapart.cpp:536
msgid "&Repositories..."
msgstr "रेपासिटरीज... (&R)"

#: cervisiapart.cpp:539
msgid "Configures a list of repositories you regularly use"
msgstr "जो आप मन नियमित उपयोग करथो ओ रेपासिटरी के सूची कान्फिगर करथे "

#: cervisiapart.cpp:546
msgid "Hide All &Files"
msgstr "सब्बो फाइल मन ल लुकाव (&F)"

#: cervisiapart.cpp:549
msgid "Determines whether only folders are shown"
msgstr "तय करथे  कि का सिरिफ फोल्डर देखाव"

#: cervisiapart.cpp:553
msgid "Hide Unmodified Files"
msgstr "अपरिवर्धित फाइल मन ल लुकाव"

#: cervisiapart.cpp:556
msgid "Determines whether files with status up-to-date or unknown are hidden"
msgstr "तय करथे  कि अपडेट करे गे या अग्यात फाइल मन ल लुकाए हे"

#: cervisiapart.cpp:561
msgid "Hide Removed Files"
msgstr "मिटाय गे फाइल मन ल लुकाव"

#: cervisiapart.cpp:564
msgid "Determines whether removed files are hidden"
msgstr "तय करथे  कि मिटाय गे फाइल मन ल लुकाव या नइ"

#: cervisiapart.cpp:568
msgid "Hide Non-CVS Files"
msgstr "नान-सीवीएस फाइल मन ल लुकाव"

#: cervisiapart.cpp:571
msgid "Determines whether files not in CVS are hidden"
msgstr "तय करथे  कि जऊन फाइल मन ल सीवीएस मं नइ हे, ओला लुकाव या नइ"

#: cervisiapart.cpp:575
msgid "Hide Empty Folders"
msgstr "खाली फोल्डर लुकाव"

#: cervisiapart.cpp:578
msgid "Determines whether folders without visible entries are hidden"
msgstr "तय करथे  कि जऊन फोल्डर दिखत प्रविस्टि के साथ नइ हे, ओला लुकाव या नइ"

#: cervisiapart.cpp:582
msgid "Create &Folders on Update"
msgstr "अपडेट करे मं फोल्डर बनाव (&F)"

#: cervisiapart.cpp:585
msgid "Determines whether updates create folders"
msgstr "तय करथे  कि अपडेट करे मं फोल्डर बनाव या नइ"

#: cervisiapart.cpp:589
msgid "&Prune Empty Folders on Update"
msgstr "अपडेट करे मं खाली फोल्डर छांटव (&P)"

#: cervisiapart.cpp:592
msgid "Determines whether updates remove empty folders"
msgstr "तय करथे  कि अपडेट करे मं खाली फोल्डर मेटाव या नइ"

#: cervisiapart.cpp:596
msgid "&Update Recursively"
msgstr "रीकर्सिवली अपडेट करव (&U)"

#: cervisiapart.cpp:599
msgid "Determines whether updates are recursive"
msgstr "तय करथे  कि अपडेट रीकर्सिव करव या नइ"

#: cervisiapart.cpp:603
msgid "C&ommit && Remove Recursively"
msgstr "भंडारित करव अउ मेटाव रीकर्सिवली (&o)"

#: cervisiapart.cpp:606
msgid "Determines whether commits and removes are recursive"
msgstr "तय करथे  कि भंडारन अउ मिटाना रीकर्सिव हे या नइ"

