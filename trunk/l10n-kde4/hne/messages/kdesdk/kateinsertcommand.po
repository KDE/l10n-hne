#: plugin_kateinsertcommand.cpp:91
msgid "Insert Command..."
msgstr "कमांड भरव..."

#: plugin_kateinsertcommand.cpp:118
msgid ""
"You are not allowed to execute arbitrary external applications. If you want "
"to be able to do this, contact your system administrator."
msgstr ""
"आप कोनो अउ बाहिरी अनुपरयोग मन ल चलाय बर अधिकृत नइ हो. यदि आप मन एला सक्छम करना "
"चाहथो तहां अपन तंत्र प्रसासक से संपर्क करव."

#: plugin_kateinsertcommand.cpp:118
msgid "Access Restrictions"
msgstr "पहुंच मं रोक"

#: plugin_kateinsertcommand.cpp:122
msgid "A process is currently being executed."
msgstr "अभी हाल मं एक प्रोसेस चलत हे"

#: plugin_kateinsertcommand.cpp:123 plugin_kateinsertcommand.cpp:251
msgid "Error"
msgstr "गलती"

#: plugin_kateinsertcommand.cpp:209
msgid "Could not kill command."
msgstr "कमांड बन्द नइ कर सकिस."

#: plugin_kateinsertcommand.cpp:209
msgid "Kill Failed"
msgstr "बन्द करना फेल"

#: plugin_kateinsertcommand.cpp:216
#, kde-format
msgid ""
"Executing command:\n"
"%1\n"
"\n"
"Press 'Cancel' to abort."
msgstr ""
"कमांड चला रहे:\n"
"%1\n"
"\n"
" रोकने बर 'खारिज' दबाव."

#: plugin_kateinsertcommand.cpp:250
#, kde-format
msgid "Command exited with status %1"
msgstr "कमांड स्टेटस %1 के साथ बाहिर होइस"

#: plugin_kateinsertcommand.cpp:291 plugin_kateinsertcommand.h:75
msgid "Insert Command"
msgstr "कमांड भरव"

#: plugin_kateinsertcommand.cpp:298
msgid "Enter &command:"
msgstr "कमांड भरव: (&c)"

#: plugin_kateinsertcommand.cpp:310
msgid "Choose &working folder:"
msgstr "काम वाले फोल्डर चुनव: (&w)"

#: plugin_kateinsertcommand.cpp:320
msgid "Insert Std&Err messages"
msgstr "Std&Err संदेस भरव"

#: plugin_kateinsertcommand.cpp:323
msgid "&Print command name"
msgstr "कमांड नाम छापव (&P)"

#: plugin_kateinsertcommand.cpp:328
msgid ""
"Enter the shell command, the output of which you want inserted into your "
"document. Feel free to use a pipe or two if you wish."
msgstr ""
"सैल कमांड भरव, जेखर आउटपुट आप मन चाहथो कि आप मन के कागद मं भरव करे जाए. आप मन एक-दो "
"पाइप के उपयोग करे बर स्वतंत्र हेयदि आप मन चाहें."

#: plugin_kateinsertcommand.cpp:331
msgid ""
"Sets the working folder of the command. The command executed is 'cd <dir> && "
"<command>'"
msgstr ""
"कमांड के काम वाले फोल्डर सेट करथे . कमांड जऊन चलाय जाथे - 'cd <dir> && <command>'"

#: plugin_kateinsertcommand.cpp:334
msgid ""
"Check this if you want the error output from <command> inserted as well.\n"
"Some commands, such as locate, print everything to STDERR"
msgstr ""
"एला जांचव यदि आप मन <कमांड> से प्राप्त गलती आउटपुट ल घलोक भरव चाहथो .\n"
"कुछ कमांड जइसन कि locate, हर चीज ल STDERR मं छापथें ."

#: plugin_kateinsertcommand.cpp:337
msgid ""
"If you check this, the command string will be printed followed by a newline "
"before the output."
msgstr ""
"यदि आप मन एला चेक करथो , तहां कमांड वाक्यांस छापे जाही एक नवा लाइन के बाद आउटपुट से "
"पहिली."

#: plugin_kateinsertcommand.cpp:384
msgid "Remember"
msgstr "याद रखव"

#: plugin_kateinsertcommand.cpp:386
msgid "Co&mmands"
msgstr "कमांड (&m)"

#: plugin_kateinsertcommand.cpp:393
msgid "Start In"
msgstr "में चालू करव"

#: plugin_kateinsertcommand.cpp:395
msgid "Application &working folder"
msgstr "अनुपरयोग काम वाले फोल्डर (&w)"

#: plugin_kateinsertcommand.cpp:396
msgid "&Document folder"
msgstr "कागद फोल्डर (&D)"

#: plugin_kateinsertcommand.cpp:397
msgid "&Latest used working folder"
msgstr "उपयोग मं एकदम नवा काम वाले फोल्डर (&L)"

#: plugin_kateinsertcommand.cpp:405
msgid ""
"Sets the number of commands to remember. The command history is saved over "
"sessions."
msgstr "याद रखे बर कमांड के संख्या सेट करथे. कमांड इतिहास सत्र मन के बीच सहेजे जाथे."

#: plugin_kateinsertcommand.cpp:408
msgid ""
"<qt><p>Decides what is suggested as <em>working folder</em> for the command."
"</p><p><strong>Application Working Folder (default):</strong> The folder "
"from which you launched the application hosting the plugin, usually your "
"home folder.</p><p><strong>Document Folder:</strong> The folder of the "
"document. Used only for local documents.</p><p><strong>Latest Working Folder:"
"</strong> The folder used last time you used this plugin.</p></qt>"
msgstr ""

#. i18n: file: ui.rc:4
#. i18n: ectx: Menu (tools)
#: rc.cpp:3
msgid "&Tools"
msgstr "औजार (&T)"

#: plugin_kateinsertcommand.h:77
msgid "Configure Insert Command Plugin"
msgstr "इंसर्ट कमांड प्लगिन ल कान्फिगर करव"

#: plugin_kateinsertcommand.h:137
msgid "Please Wait"
msgstr "किरपा करके, अगोरव...."
