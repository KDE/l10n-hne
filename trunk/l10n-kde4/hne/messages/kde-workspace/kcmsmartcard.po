#: smartcard.cpp:395
msgid ""
"<h1>smartcard</h1> This module allows you to configure KDE support for "
"smartcards. These can be used for various tasks such as storing SSL "
"certificates and logging in to the system."
msgstr ""

#~ msgid "<b>Unable to contact the KDE smartcard service.</b>"
#~ msgstr "<b>केडीई स्मार्ट कार्ड सेवा से सम्पर्क मं अक्छम.</b>"

#~ msgid "Possible Reasons"
#~ msgstr "संभावित कारन"

#~ msgid "Smartcard Support"
#~ msgstr "स्मार्ट-कार्ड समर्थन"

#~ msgid "&Enable smartcard support"
#~ msgstr "स्मार्ट-कार्ड समर्थन सक्छम करव (&E)"

#~ msgid "Enable &polling to autodetect card events"
#~ msgstr "कार्ड घटना मन ल अपने अपन पता लगाय बर पोलिंग सक्छम करव. (&p)"

#~ msgid ""
#~ "In most cases you should have this enabled. It allows KDE to "
#~ "automatically detect card insertion and reader hotplug events."
#~ msgstr ""
#~ "प्रायः सब्बो दसा मं आप मन ल एला सक्छम कर रखना होही. ए केडीई ल कार्ड इंसर्सन अउ "
#~ "रीडर हाटप्लग घटना अपने अपन पता लगन देथे."

#~ msgid "Automatically &launch card manager if inserted card is unclaimed"
#~ msgstr "यदि घुसाय गे कार्ड दावा रहित रहथे  तहां कार्ड प्रबंधक अपने अपन चालू करव (&l)"

#~ msgid ""
#~ "When you insert a smartcard, KDE can automatically launch a management "
#~ "tool if no other application attempts to use the card."
#~ msgstr ""
#~ "जब आप मन एक स्मार्टकार्ड घुसाथो , केडीई अपने अपन एक प्रबंधन औजार चालू करथे  यदि "
#~ "कोनो अउ अनुपरयोग कार्ड ल उपयोग करे बर प्रयास नइ करथे."

#~ msgid "&Beep on card insert and removal"
#~ msgstr "कार्ड घुसाय अउ निकाले मं बीप करव (&B)"

#~ msgid "Readers"
#~ msgstr "रीडर्स"

#~ msgid "Reader"
#~ msgstr "रीडर"

#~ msgid "Type"
#~ msgstr "किसिम"

#~ msgid "Subtype"
#~ msgstr "उपकिसिम"

#~ msgid "SubSubtype"
#~ msgstr "उप-उपकिसम"

#~ msgid "PCSCLite Configuration"
#~ msgstr "पीसीएससी-लाइट कान्फिगरेसन"

#~ msgid ""
#~ "To add new readers you have to modify /etc/readers.conf file and re-start "
#~ "pcscd"
#~ msgstr ""
#~ "नवा रीडर जोड़े बर आप मन ल /etc/readers.conf फाइल ल परिवर्धित करना होही अउ "
#~ "pcscd ल फिर से  चालू करना होही"
