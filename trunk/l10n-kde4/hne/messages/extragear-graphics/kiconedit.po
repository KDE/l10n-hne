#: kiconedit.cpp:465
#, kde-format
msgid "Flood Fill"
msgstr "पूरा भरव"

#: kiconedit.cpp:469
#, kde-format
msgid ""
"Flood fill\n"
"\n"
"Fill adjoining pixels with the same color with the current color"
msgstr ""
"फ्लड फिल\n"
"\n"
"आसपास के, एके रंग के पिक्सलों ल अभी हाल के रंग से भरथे "

#: kiconedit.cpp:474
#, kde-format
msgid "Line"
msgstr "पंक्ति"

#: kiconedit.cpp:478
#, kde-format
msgid ""
