msgstr "मेटाव के रबर (पारदर्सी)"

#: kiconedit.cpp:487
#, kde-format
msgid ""
"Erase\n"
"\n"
"Erase pixels. Set the pixels to be transparent\n"
"\n"
"(Tip: If you want to draw transparency with a different tool, first click on "
"\"Erase\" then on the tool you want to use)"
msgstr ""

#: kiconedit.cpp:494
#, kde-format
msgid "Rectangular Selection"
msgstr "चतुर्भुज चयन"

#: kiconedit.cpp:498
#, kde-format
msgid ""
"Select\n"
"\n"
"Select a rectangular section of the icon using the mouse."
msgstr ""
"चुनव\n"
"\n"
"मुसुवा के उपयोग कर चिनहा के आयताकार खन्ड चुनव."

#: kiconedit.cpp:503
#, kde-format
