"Zoom in by one."
msgstr ""
"जूम इन\n"
"\n"
"एक से जूम इन"

#: kiconedit.cpp:331
#, kde-format
msgid ""
"Zoom out\n"
"\n"
"Zoom out by one."
msgstr ""
"जूम आउट\n"
"\n"
"एक से जूम आउट."

#: kiconedit.cpp:335
#, kde-format
msgid "&Zoom"
msgstr "जूम (&Z)"

