#: main.cpp:111
msgid "Incidence types (these options can be combined):"
msgstr "घटना किसिम (ए विकल्प मन ल सम्मिलित करे जा सकथे ):"

#: main.cpp:113
msgid "  Operate for Events only (Default)"
msgstr "  सिरिफ घटना बर आपरेट (डिफाल्ट)"

#: main.cpp:115
msgid "  Operate for To-dos only [NOT WORKING YET]"
msgstr "  सिरिफ काम सूची बर आपरेट [अभी काम नइ करे]"

#: main.cpp:117
msgid "  Operate for Journals only [NOT WORKING YET]"
msgstr "  सिरिफ जर्नल्स बर आपरेट [अभी काम नइ करे]"

#: main.cpp:119
msgid "Major operation modes:"
msgstr "मुख्य आपरेसन मोड्स:"

#: main.cpp:121
msgid "  Print incidences in specified export format"
msgstr "  निरधारित निर्यात फारमेट मं घटना छापव"

#: main.cpp:123
msgid "  Insert an incidence into the calendar"
msgstr "  कलेन्डर तिर कोनो घटना भरव"

#: main.cpp:125
msgid "  Modify an existing incidence"
msgstr "  अभी हाल के घटना ल सुधारव"

#: main.cpp:127
msgid "  Remove an existing incidence"
msgstr "  अभी हाल के घटना ल मेटाव"

#: main.cpp:129
msgid "  Create new calendar file if one does not exist"
msgstr "यदि मौजूद नइ हे तहां एक नवा कलेन्डर फाइल तैयार करव"

#: main.cpp:131
msgid "  Import this calendar to main calendar"
msgstr "ये कलेन्डर ल मुख्य कलेन्डर मं आयात करव"

#: main.cpp:133
msgid "Operation modifiers:"
msgstr "आपरेसन परिवर्धक:"

#: main.cpp:135
msgid "  View all calendar entries, ignoring date/time options"
msgstr "  सब्बो कलेन्डर प्रविस्टि मन ल देखाव, तारीक/समय विकल्प ल अनदेखा करव"

#: main.cpp:137
msgid "  View next activity in calendar"
msgstr "कलेन्डर मं अगले कामधाम ल देखव"

#: main.cpp:139
msgid "  From start date show next # days' activities"
msgstr "  चालू तारीक से अगले # दिनों के काम देखाव"

#: main.cpp:141
msgid "  Incidence Unique-string identifier"
msgstr "  घटना यूनीक-स्ट्रिंग आइडेंटिफायर"

#: main.cpp:143
msgid "  Start from this day [YYYY-MM-DD]"
msgstr "ये तारीक से चालू करव [YYYY-MM-DD]"

#: main.cpp:145
msgid "  Start from this time [HH:MM:SS]"
msgstr "ये समय से चालू करव [HH:MM:SS]"

#: main.cpp:147
msgid "  End at this day [YYYY-MM-DD]"
msgstr "ये तारीक ल खतम करव [YYYY-MM-DD]"

#: main.cpp:149
msgid "  End at this time [HH:MM:SS]"
msgstr "ये समय खतम करव [HH:MM:SS]"

#: main.cpp:151
msgid " Start from this time [secs since epoch]"
msgstr "ये समय से चालू करव [तब से सेकन्ड]"

#: main.cpp:153
msgid "  End at this time [secs since epoch]"
msgstr "ये समय खतम करव [तब से सेकन्ड]"

#: main.cpp:155
msgid "  Add summary to incidence (for add/change modes)"
msgstr "  घटना मं सारांस जोड़व (जोड़व/बदलव मोड बर)"

#: main.cpp:157
msgid "Add description to incidence (for add/change modes)"
msgstr "घटना मं वर्नन जोड़व (जोड़व/बदलव मोड बर)"

#: main.cpp:159
msgid "  Add location to incidence (for add/change modes)"
msgstr "  घटना मं जगह जोड़व (जोड़व/बदलव मोड बर)"

#: main.cpp:161
msgid "Export options:"
msgstr "निर्यात विकल्प:"

#: main.cpp:163
msgid "Export file type (Default: text)"
msgstr "निर्यात फाइल किसिम (डिफाल्टः पाठ)"

#: main.cpp:165
msgid "Export to file (Default: stdout)"
msgstr "फाइल मं निर्यात करव (डिफाल्टः stdout)"

#: main.cpp:167
msgid "  Print list of export types supported and exit"
msgstr "समर्थित निर्यात किसिम के सूची छापव अउ बाहिर हों"

#: main.cpp:169
msgid ""
"Examples:\n"
"  konsolekalendar --view\n"
"  konsolekalendar --add --date 2003-06-04 --time 10:00 --end-time 12:00 \\\n"
"                  --summary \"Doctor Visit\" --description \"Get My Head "
"Examined\"\n"
"  konsolekalendar --delete --uid KOrganizer-1740326.803"
msgstr ""

#: main.cpp:177
msgid ""
"For more information visit the program home page at:\n"
"  http://pim.kde.org/components/konsolekalendar.php"
